---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Career | Teo Jun Cheng">

    <!-- 1. HERO HEADER -->
    <header class="career-hero">
        <div class="terminal-tag">// CAREER</div>
        <h1 class="page-title">My <span class="highlight">Journey</span></h1>
        <p class="hero-intro">
            From a Software Engineering student in Sabah to building full-stack mobile and web products — here is my professional experience, academic achievements, and current credentials.
        </p>
        <div class="hero-actions">
            <a href="/Resume.pdf" download="Teo_Jun_Cheng_Resume.pdf" class="btn btn-primary">Download CV</a>
            <a href="/contact" class="btn btn-outline">Get in Touch</a>
        </div>
    </header>

    <div class="divider"></div>

    <!-- 2. WORK EXPERIENCE -->
    <section class="content-section">
        <div class="terminal-tag">// WORK EXPERIENCE</div>
        <h2 class="section-heading">Experience</h2>

        <div class="experience-list">
            <div class="exp-card">
                <div class="exp-header">
                    <div class="exp-role-group">
                        <span class="exp-icon">💼</span>
                        <div>
                            <h3 class="exp-title">Software Engineer Intern</h3>
                            <div class="exp-company">Apploqic Technologies • Kuala Lumpur</div>
                        </div>
                    </div>
                    <span class="exp-badge">Mar 2026 – Aug 2026</span>
                </div>

                <ul class="exp-duties">
                    <li>Developed and shipped decoupled cross-platform mobile applications (Client Quotation Request & Property Management) utilizing Flutter integrated with Laravel REST APIs.</li>
                    <li>Maintained, debugged, and optimized live client websites hosted across cPanel, WordPress, and Elementor environments.</li>
                    <li>Collaborated with senior engineers to implement relational database schemas and automated workflow pipelines.</li>
                </ul>

                <div class="exp-tags">
                    <span class="tag tag-highlight">Flutter</span>
                    <span class="tag">Dart</span>
                    <span class="tag tag-highlight">Laravel API</span>
                    <span class="tag">MySQL</span>
                    <span class="tag">cPanel</span>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. EDUCATION & AWARDS -->
    <section class="content-section">
        <div class="terminal-tag">// ACADEMICS</div>
        <h2 class="section-heading">Education & Honors</h2>

        <div class="education-grid">
            <div class="edu-card">
                <div class="edu-badge">2022 – 2026</div>
                <h3 class="edu-degree">Bachelor of Computer Science (Software Engineering)</h3>
                <div class="edu-school">Universiti Malaysia Sabah (UMS)</div>
                <p class="edu-desc">
                    Maintaining a cumulative CGPA of <strong>3.74</strong> across all semesters with consistent placement on the Dean's Honour List.
                </p>
                <div class="award-pill">🏆 6× Dean's List Award</div>
            </div>

            <div class="edu-card">
                <div class="edu-badge">2025</div>
                <h3 class="edu-degree">UM Hackathon Participant</h3>
                <div class="edu-school">Universiti Malaya</div>
                <p class="edu-desc">
                    Engineered an AI-driven sales recommendation assistant prototype analyzing customer behavioral data.
                </p>
                <div class="award-pill">🤖 AI Prototype Track</div>
            </div>
        </div>
    </section>

    <!-- 4. RESUME VIEWER -->
    <section class="content-section" style="margin-bottom: 5rem;">
        <div class="terminal-tag">// CREDENTIALS</div>
        <h2 class="section-heading">Curriculum Vitae</h2>

        <div class="resume-wrapper">
            <div class="resume-toolbar">
                <div class="doc-name">Teo_Jun_Cheng_Resume.pdf</div>
                <div class="toolbar-actions">
                    <a href="/Resume.pdf" target="_blank" class="tool-btn">Open in New Tab ↗</a>
                    <a href="/Resume.pdf" download="Teo_Jun_Cheng_Resume.pdf" class="tool-btn tool-btn-primary">Download</a>
                </div>
            </div>
            <iframe 
                src="/Resume.pdf" 
                class="pdf-frame" 
                title="Teo Jun Cheng Resume">
            </iframe>
        </div>
    </section>

</Layout>

<style>
    /* Hero */
    .career-hero {
        padding: 5rem 0 2rem;
        max-width: 820px;
    }

    .terminal-tag {
        font-family: 'JetBrains Mono', monospace;
        color: #38bdf8;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        letter-spacing: 0.05em;
    }

    .page-title {
        font-size: 3.25rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.15;
        margin-bottom: 1.25rem;
        letter-spacing: -0.03em;
    }

    .highlight {
        color: #38bdf8;
    }

    .hero-intro {
        color: #94a3b8;
        font-size: 1.15rem;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.6rem;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-primary {
        background-color: #38bdf8;
        color: #082f49;
    }

    .btn-primary:hover {
        background-color: #7dd3fc;
        transform: translateY(-2px);
        box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
    }

    .btn-outline {
        background-color: transparent;
        border: 1px solid #1e293b;
        color: #cbd5e1;
    }

    .btn-outline:hover {
        border-color: #38bdf8;
        color: #ffffff;
    }

    .divider {
        height: 1px;
        background-color: #1e293b;
        margin: 2.5rem 0 3.5rem;
    }

    /* Content Sections */
    .content-section {
        margin-bottom: 4.5rem;
    }

    .section-heading {
        font-size: 2rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 2rem;
        letter-spacing: -0.02em;
    }

    /* Experience Card */
    .exp-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 2rem;
        transition: border-color 0.2s ease;
    }

    .exp-card:hover {
        border-color: #38bdf8;
    }

    .exp-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .exp-role-group {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .exp-icon {
        font-size: 2rem;
    }

    .exp-title {
        color: #ffffff;
        font-size: 1.25rem;
        font-weight: 700;
    }

    .exp-company {
        color: #94a3b8;
        font-size: 0.95rem;
    }

    .exp-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        background-color: rgba(56, 189, 248, 0.15);
        color: #38bdf8;
        border: 1px solid rgba(56, 189, 248, 0.3);
        padding: 0.35rem 0.8rem;
        border-radius: 20px;
    }

    .exp-duties {
        color: #94a3b8;
        font-size: 0.95rem;
        line-height: 1.8;
        padding-left: 1.5rem;
        margin-bottom: 1.75rem;
    }

    .exp-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        background-color: #1e293b;
        color: #cbd5e1;
        padding: 0.3rem 0.7rem;
        border-radius: 6px;
    }

    .tag-highlight {
        border: 1px solid rgba(56, 189, 248, 0.4);
        color: #38bdf8;
    }

    /* Education Grid */
    .education-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .edu-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .edu-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #38bdf8;
        margin-bottom: 0.5rem;
    }

    .edu-degree {
        color: #ffffff;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .edu-school {
        color: #94a3b8;
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    .edu-desc {
        color: #94a3b8;
        font-size: 0.92rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    .award-pill {
        display: inline-flex;
        align-self: flex-start;
        font-size: 0.85rem;
        font-weight: 600;
        background-color: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.3);
        padding: 0.35rem 0.85rem;
        border-radius: 20px;
    }

    /* PDF Viewer Container */
    .resume-wrapper {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 12px;
        overflow: hidden;
    }

    .resume-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #060913;
        border-bottom: 1px solid #1e293b;
        padding: 0.85rem 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .doc-name {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.88rem;
        color: #cbd5e1;
    }

    .toolbar-actions {
        display: flex;
        gap: 0.75rem;
    }

    .tool-btn {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        text-decoration: none;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        background-color: #1e293b;
        color: #cbd5e1;
        transition: all 0.2s ease;
    }

    .tool-btn:hover {
        background-color: #334155;
        color: #ffffff;
    }

    .tool-btn-primary {
        background-color: rgba(56, 189, 248, 0.2);
        color: #38bdf8;
        border: 1px solid rgba(56, 189, 248, 0.4);
    }

    .tool-btn-primary:hover {
        background-color: #38bdf8;
        color: #082f49;
    }

    .pdf-frame {
        width: 100%;
        height: 750px;
        border: none;
        background-color: #ffffff;
    }
</style>
