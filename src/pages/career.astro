---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Career | Teo Jun Cheng">

    <!-- 1. HERO HEADER -->
    <header class="career-hero">
        <div class="section-tag">01 // TRAJECTORY</div>
        <h1 class="hero-title">Experience & <span class="gradient-text">Credentials</span>.</h1>
        <p class="hero-intro">
            A comprehensive overview of my software engineering roles, academic standing, technical responsibilities, and curriculum vitae.
        </p>
        <div class="hero-actions">
            <a href="/Resume.pdf" download="Teo_Jun_Cheng_Resume.pdf" class="btn btn-emerald">Download CV (PDF)</a>
            <a href="/contact" class="btn btn-ghost">Discuss Opportunities</a>
        </div>
    </header>

    <!-- 2. EDUCATION SECTION -->
    <section class="section-container">
        <div class="section-header-block">
            <div class="section-icon-box">
                <span>🎓</span>
            </div>
            <div>
                <div class="section-tag-inline">02 // ACADEMICS</div>
                <h2 class="section-heading-clean">Education</h2>
            </div>
        </div>

        <div class="timeline-container">
            <div class="timeline-item">
                <div class="timeline-marker">
                    <span class="timeline-dot"></span>
                    <span class="timeline-line"></span>
                </div>
                <div class="timeline-content">
                    <div class="edu-header">
                        <h3 class="item-title">Universiti Malaysia Sabah</h3>
                        <span class="item-date">2022 — 2026</span>
                    </div>
                    <div class="edu-subtitle">Bachelor of Computer Science (Software Engineering)</div>
                    <div class="edu-honors text-emerald">3.76 CGPA • 7× Dean's List Honors</div>
                    <p class="item-desc">
                        Underwent comprehensive software engineering training spanning system design patterns, algorithmic optimization, and relational data structures. Built ServeTogether as FYP and competed in the UM Hackathon AI track.
                    </p>

                    <div class="tag-row">
                        <span class="mono-badge">Distributed Systems</span>
                        <span class="mono-badge">Full-Stack Web</span>
                        <span class="mono-badge">Machine Learning</span>
                    </div>

                    <!-- Credential / Academic Image -->
                    <div class="academic-image-container">
                        <img 
                            src="/academics.png" 
                            alt="Teo Jun Cheng Academic Honors & Dean's List Record" 
                            class="academic-img"
                            onerror="this.parentElement.classList.add('img-placeholder');"
                        />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. WORKING EXPERIENCE SECTION -->
    <section class="section-container">
        <div class="section-header-block">
            <div class="section-icon-box">
                <span>💼</span>
            </div>
            <div>
                <div class="section-tag-inline">03 // CAREER</div>
                <h2 class="section-heading-clean">Working Experience</h2>
            </div>
        </div>

        <div class="timeline-container">
            <div class="timeline-item">
                <div class="timeline-marker">
                    <span class="timeline-dot"></span>
                </div>
                <div class="timeline-content">
                    <div class="edu-header">
                        <h3 class="item-title">Software Engineer Intern</h3>
                        <span class="item-date">March 2026 — August 2026</span>
                    </div>
                    <div class="company-link">Apploqic Technologies • Kuala Lumpur, Malaysia</div>

                    <ul class="exp-bullets">
                        <li>Architected and delivered decoupled mobile client features (Client Quotation Estimator and Property Management systems) utilizing <strong>Flutter</strong> and <strong>Dart</strong>.</li>
                        <li>Implemented and consumed structured <strong>Laravel RESTful APIs</strong> with secure authentication and real-time database transactions.</li>
                        <li>Maintained live client infrastructure on <strong>cPanel</strong>, including staging management, database indexing, and WordPress/Elementor environment deployments.</li>
                        <li>Collaborated with senior software architects to refine schema design patterns and maintain code reliability.</li>
                    </ul>

                    <div class="tech-row">
                        <span class="tech-chip tag-featured">Flutter</span>
                        <span class="tech-chip tag-featured">Laravel</span>
                        <span class="tech-chip">Dart</span>
                        <span class="tech-chip">MySQL</span>
                        <span class="tech-chip">REST APIs</span>
                        <span class="tech-chip">cPanel</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. EMBEDDED CURRICULUM VITAE -->
    <section class="section-container" style="margin-bottom: 6rem;">
        <div class="section-header-block">
            <div class="section-icon-box">
                <span>📄</span>
            </div>
            <div>
                <div class="section-tag-inline">04 // RESUME</div>
                <h2 class="section-heading-clean">Curriculum Vitae</h2>
            </div>
        </div>

        <div class="pdf-viewer-card">
            <div class="pdf-header">
                <div class="pdf-file-details">
                    <span class="terminal-symbol">$</span>
                    <span class="file-title">Teo_Jun_Cheng_Resume.pdf</span>
                </div>
                <div class="pdf-actions">
                    <a href="/Resume.pdf" target="_blank" class="viewer-btn">Open in New Tab ↗</a>
                    <a href="/Resume.pdf" download="Teo_Jun_Cheng_Resume.pdf" class="viewer-btn viewer-btn-highlight">Download</a>
                </div>
            </div>
            <iframe 
                src="/Resume.pdf" 
                class="pdf-display"
                title="Teo Jun Cheng Curriculum Vitae">
            </iframe>
        </div>
    </section>

</Layout>

<style>
    /* Hero */
    .career-hero {
        padding: 5rem 0 3.5rem;
        max-width: 860px;
    }

    .section-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #10b981;
        letter-spacing: 0.1em;
        margin-bottom: 0.75rem;
    }

    .section-tag-inline {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #10b981;
        letter-spacing: 0.08em;
    }

    .hero-title {
        font-size: 2.85rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.2;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }

    .gradient-text {
        background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-intro {
        color: #94a3b8;
        font-size: 1.15rem;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.6rem;
        border-radius: 6px;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-emerald {
        background-color: #10b981;
        color: #022c22;
    }

    .btn-emerald:hover {
        background-color: #34d399;
        transform: translateY(-2px);
        box-shadow: 0 4px 18px rgba(16, 185, 129, 0.3);
    }

    .btn-ghost {
        background-color: #0f172a;
        color: #cbd5e1;
        border: 1px solid #1e293b;
    }

    .btn-ghost:hover {
        border-color: #10b981;
        color: #ffffff;
    }

    /* Section Structure */
    .section-container {
        margin-bottom: 4.5rem;
    }

    .section-header-block {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .section-icon-box {
        width: 42px;
        height: 42px;
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .section-heading-clean {
        font-size: 1.75rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.02em;
        margin: 0;
    }

    /* Timeline Container & Items */
    .timeline-container {
        display: flex;
        flex-direction: column;
        padding-left: 0.5rem;
    }

    .timeline-item {
        display: flex;
        gap: 1.5rem;
        position: relative;
    }

    .timeline-marker {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 20px;
        flex-shrink: 0;
    }

    .timeline-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: #f59e0b;
        box-shadow: 0 0 10px rgba(245, 158, 11, 0.6);
        margin-top: 0.5rem;
        flex-shrink: 0;
    }

    .timeline-line {
        width: 2px;
        background-color: #1e293b;
        flex-grow: 1;
        margin-top: 0.5rem;
    }

    .timeline-content {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2rem;
        flex-grow: 1;
        margin-bottom: 2rem;
        transition: border-color 0.2s ease;
    }

    .timeline-content:hover {
        border-color: #10b981;
    }

    .edu-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.35rem;
    }

    .item-title {
        color: #ffffff;
        font-size: 1.3rem;
        font-weight: 700;
        margin: 0;
    }

    .item-date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: #f59e0b;
        font-weight: 500;
    }

    .edu-subtitle {
        color: #cbd5e1;
        font-size: 1rem;
        font-weight: 500;
        margin-bottom: 0.35rem;
    }

    .company-link {
        color: #10b981;
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 1.25rem;
    }

    .edu-honors {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .text-emerald {
        color: #34d399 !important;
    }

    .item-desc {
        color: #94a3b8;
        font-size: 0.95rem;
        line-height: 1.7;
        margin-bottom: 1.25rem;
    }

    .tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.75rem;
    }

    .mono-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        background-color: #162032;
        color: #94a3b8;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        border: 1px solid #223249;
    }

    /* Embedded Academic Image */
    .academic-image-container {
        width: 100%;
        max-height: 480px;
        background-color: #090d16;
        border: 1px solid #162032;
        border-radius: 6px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .academic-img {
        width: 100%;
        height: auto;
        max-height: 480px;
        object-fit: contain;
        display: block;
    }

    .img-placeholder::after {
        content: "Place academic photo or transcript in public/academics.png";
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: #64748b;
        padding: 3rem 1rem;
        display: block;
    }

    /* Work Experience List */
    .exp-bullets {
        color: #94a3b8;
        font-size: 0.93rem;
        line-height: 1.8;
        padding-left: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        margin-bottom: 1.5rem;
    }

    .exp-bullets strong {
        color: #f1f5f9;
    }

    .tech-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        border-top: 1px solid #162032;
        padding-top: 1.25rem;
    }

    .tech-chip {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        background-color: #162032;
        color: #94a3b8;
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        border: 1px solid #223249;
    }

    .tag-featured {
        border-color: rgba(16, 185, 129, 0.35);
        color: #34d399;
    }

    /* PDF Viewer */
    .pdf-viewer-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        overflow: hidden;
    }

    .pdf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #090d16;
        border-bottom: 1px solid #1e293b;
        padding: 0.85rem 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .pdf-file-details {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
    }

    .terminal-symbol {
        color: #10b981;
    }

    .file-title {
        color: #cbd5e1;
    }

    .pdf-actions {
        display: flex;
        gap: 0.5rem;
    }

    .viewer-btn {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        text-decoration: none;
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        background-color: #162032;
        color: #cbd5e1;
        border: 1px solid #223249;
        transition: all 0.2s ease;
    }

    .viewer-btn:hover {
        background-color: #1e293b;
        color: #ffffff;
    }

    .viewer-btn-highlight {
        background-color: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border-color: rgba(16, 185, 129, 0.35);
    }

    .viewer-btn-highlight:hover {
        background-color: #10b981;
        color: #022c22;
    }

    .pdf-display {
        width: 100%;
        height: 750px;
        border: none;
        background-color: #ffffff;
    }
</style>
