---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Career | Teo Jun Cheng">

    <!-- 1. HERO HEADER -->
    <header class="career-hero">
        <div class="section-tag">01 // TRAJECTORY</div>
        <h1 class="hero-title">Experience & <span class="gradient-text">Credentials</span>.</h1>
        <p class="hero-intro">
            A comprehensive overview of my software engineering roles, academic standing, technical responsibilities, and curriculum vitae.
        </p>
        <div class="hero-actions">
            <a href="/Resume.pdf" download="Teo_Jun_Cheng_Resume.pdf" class="btn btn-emerald">Download CV (PDF)</a>
            <a href="/contact" class="btn btn-ghost">Discuss Opportunities</a>
        </div>
    </header>

    <!-- 2. SUMMARY METRICS BAR -->
    <section class="career-metrics">
        <div class="metric-item">
            <span class="metric-val text-emerald">3.74</span>
            <span class="metric-sub">CGPA (UMS)</span>
        </div>
        <div class="metric-item">
            <span class="metric-val">6×</span>
            <span class="metric-sub">Dean's List Recipient</span>
        </div>
        <div class="metric-item">
            <span class="metric-val">Full-Stack</span>
            <span class="metric-sub">Flutter & Laravel API</span>
        </div>
        <div class="metric-item">
            <span class="metric-val text-emerald">Sept 2026</span>
            <span class="metric-sub">Available For Hire</span>
        </div>
    </section>

    <!-- 3. WORK EXPERIENCE -->
    <section class="section-container">
        <div class="section-tag">02 // ROLES</div>
        <h2 class="section-heading">Work Experience</h2>

        <div class="experience-stack">
            <article class="experience-card">
                <div class="exp-header">
                    <div class="exp-identity">
                        <span class="exp-badge">INTERNSHIP</span>
                        <h3 class="exp-position">Software Engineer Intern</h3>
                        <div class="exp-firm">Apploqic Technologies • Kuala Lumpur, Malaysia</div>
                    </div>
                    <div class="exp-duration">March 2026 – August 2026</div>
                </div>

                <div class="exp-content">
                    <p class="exp-summary">
                        Contributed to core product development across cross-platform mobile architectures and backend services for diverse business domains.
                    </p>
                    <ul class="exp-bullets">
                        <li>Architected and delivered decoupled mobile client features (Client Quotation Estimator and Property Management systems) utilizing <strong>Flutter</strong> and <strong>Dart</strong>.</li>
                        <li>Implemented and consumed structured <strong>Laravel RESTful APIs</strong> with secure authentication and real-time database transactions.</li>
                        <li>Maintained live client infrastructure on <strong>cPanel</strong>, including staging management, database indexing, and WordPress/Elementor environment deployments.</li>
                        <li>Collaborated with senior software architects to refine schema design patterns and maintain code reliability.</li>
                    </ul>
                </div>

                <div class="exp-footer">
                    <span class="tech-chip tag-featured">Flutter</span>
                    <span class="tech-chip tag-featured">Laravel</span>
                    <span class="tech-chip">Dart</span>
                    <span class="tech-chip">MySQL</span>
                    <span class="tech-chip">REST APIs</span>
                    <span class="tech-chip">cPanel</span>
                </div>
            </article>
        </div>
    </section>

    <!-- 4. ACADEMICS & RECOGNITION -->
    <section class="section-container">
        <div class="section-tag">03 // ACADEMICS</div>
        <h2 class="section-heading">Education & Honors</h2>

        <div class="academics-grid">
            <div class="academic-card">
                <div class="academic-top">
                    <span class="period-pill">2022 – 2026</span>
                    <span class="honor-tag">HONORS</span>
                </div>
                <h3 class="degree-title">Bachelor of Computer Science (Software Engineering)</h3>
                <div class="school-name">Universiti Malaysia Sabah (UMS)</div>
                <p class="academic-body">
                    Maintained high academic standing with a cumulative CGPA of <strong>3.74</strong>. Specialized in software architecture, distributed applications, and data algorithms.
                </p>
                <div class="academic-status">
                    <span class="status-dot"></span> 6× Dean's List Award Recipient
                </div>
            </div>

            <div class="academic-card">
                <div class="academic-top">
                    <span class="period-pill">2025</span>
                    <span class="honor-tag">COMPETITION</span>
                </div>
                <h3 class="degree-title">UM Hackathon Participant</h3>
                <div class="school-name">Universiti Malaya</div>
                <p class="academic-body">
                    Built an end-to-end AI sales recommendation assistant prototype analyzing customer behavioural signals for automated upselling workflows.
                </p>
                <div class="academic-status">
                    <span class="status-dot"></span> Machine Learning Prototype Track
                </div>
            </div>
        </div>
    </section>

    <!-- 5. EMBEDDED CURRICULUM VITAE -->
    <section class="section-container" style="margin-bottom: 6rem;">
        <div class="section-tag">04 // RESUME</div>
        <h2 class="section-heading">Curriculum Vitae</h2>

        <div class="pdf-viewer-card">
            <div class="pdf-header">
                <div class="pdf-file-details">
                    <span class="terminal-symbol">$</span>
                    <span class="file-title">Teo_Jun_Cheng_Resume.pdf</span>
                </div>
                <div class="pdf-actions">
                    <a href="/Resume.pdf" target="_blank" class="viewer-btn">Open in New Tab ↗</a>
                    <a href="/Resume.pdf" download="Teo_Jun_Cheng_Resume.pdf" class="viewer-btn viewer-btn-highlight">Download</a>
                </div>
            </div>
            <iframe 
                src="/Resume.pdf" 
                class="pdf-display"
                title="Teo Jun Cheng Curriculum Vitae">
            </iframe>
        </div>
    </section>

</Layout>

<style>
    /* Hero */
    .career-hero {
        padding: 5rem 0 2.5rem;
        max-width: 860px;
    }

    .section-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #10b981;
        letter-spacing: 0.1em;
        margin-bottom: 0.75rem;
    }

    .hero-title {
        font-size: 2.85rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.2;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }

    .gradient-text {
        background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-intro {
        color: #94a3b8;
        font-size: 1.15rem;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.6rem;
        border-radius: 6px;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-emerald {
        background-color: #10b981;
        color: #022c22;
    }

    .btn-emerald:hover {
        background-color: #34d399;
        transform: translateY(-2px);
        box-shadow: 0 4px 18px rgba(16, 185, 129, 0.3);
    }

    .btn-ghost {
        background-color: #0c1222;
        color: #cbd5e1;
        border: 1px solid #1e293b;
    }

    .btn-ghost:hover {
        border-color: #10b981;
        color: #ffffff;
    }

    /* Metric Bar */
    .career-metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1.25rem;
        margin: 2.5rem 0 5rem;
    }

    .metric-item {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .metric-val {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.85rem;
        font-weight: 800;
        color: #f8fafc;
    }

    .metric-sub {
        font-size: 0.82rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .text-emerald {
        color: #34d399 !important;
    }

    /* Section Structure */
    .section-container {
        margin-bottom: 5.5rem;
    }

    .section-heading {
        font-size: 1.85rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.02em;
        margin-bottom: 2rem;
    }

    /* Experience Card */
    .experience-stack {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .experience-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2.25rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        transition: border-color 0.2s ease;
    }

    .experience-card:hover {
        border-color: #10b981;
    }

    .exp-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1rem;
        border-bottom: 1px solid #162032;
        padding-bottom: 1.25rem;
    }

    .exp-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: #10b981;
        background-color: rgba(16, 185, 129, 0.1);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        letter-spacing: 0.05em;
        display: inline-block;
        margin-bottom: 0.5rem;
    }

    .exp-position {
        color: #ffffff;
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .exp-firm {
        color: #94a3b8;
        font-size: 0.95rem;
    }

    .exp-duration {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: #64748b;
    }

    .exp-summary {
        color: #cbd5e1;
        font-size: 0.98rem;
        line-height: 1.6;
        margin-bottom: 1rem;
    }

    .exp-bullets {
        color: #94a3b8;
        font-size: 0.93rem;
        line-height: 1.8;
        padding-left: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .exp-bullets strong {
        color: #f1f5f9;
    }

    .exp-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding-top: 0.75rem;
    }

    .tech-chip {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        background-color: #162032;
        color: #94a3b8;
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        border: 1px solid #223249;
    }

    .tag-featured {
        border-color: rgba(16, 185, 129, 0.35);
        color: #34d399;
    }

    /* Academics Grid */
    .academics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .academic-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.25rem;
    }

    .academic-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .period-pill {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        color: #10b981;
    }

    .honor-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        background-color: #162032;
        color: #64748b;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
    }

    .degree-title {
        color: #ffffff;
        font-size: 1.2rem;
        font-weight: 700;
        line-height: 1.4;
    }

    .school-name {
        color: #94a3b8;
        font-size: 0.9rem;
    }

    .academic-body {
        color: #94a3b8;
        font-size: 0.92rem;
        line-height: 1.6;
    }

    .academic-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: #34d399;
        font-weight: 600;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #34d399;
    }

    /* PDF Viewer */
    .pdf-viewer-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        overflow: hidden;
    }

    .pdf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #090d16;
        border-bottom: 1px solid #1e293b;
        padding: 0.85rem 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .pdf-file-details {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
    }

    .terminal-symbol {
        color: #10b981;
    }

    .file-title {
        color: #cbd5e1;
    }

    .pdf-actions {
        display: flex;
        gap: 0.5rem;
    }

    .viewer-btn {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        text-decoration: none;
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        background-color: #162032;
        color: #cbd5e1;
        border: 1px solid #223249;
        transition: all 0.2s ease;
    }

    .viewer-btn:hover {
        background-color: #1e293b;
        color: #ffffff;
    }

    .viewer-btn-highlight {
        background-color: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border-color: rgba(16, 185, 129, 0.35);
    }

    .viewer-btn-highlight:hover {
        background-color: #10b981;
        color: #022c22;
    }

    .pdf-display {
        width: 100%;
        height: 750px;
        border: none;
        background-color: #ffffff;
    }
</style>
