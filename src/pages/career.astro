---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Career | Teo Jun Cheng">

    <!-- 1. HERO HEADER -->
    <header class="career-hero">
        <div class="section-tag">01 // TRAJECTORY</div>
        <h1 class="hero-title">Experience & <span class="gradient-text">Credentials</span>.</h1>
        <p class="hero-intro">
            A comprehensive overview of my software engineering roles, academic standing, technical responsibilities, and curriculum vitae.
        </p>
        <div class="hero-actions">
            <a href="/Resume.pdf" download="Teo_Jun_Cheng_Resume.pdf" class="btn btn-emerald">Download CV (PDF)</a>
            <a href="/contact" class="btn btn-ghost">Discuss Opportunities</a>
        </div>
    </header>

    <!-- 2. CAREER & ACADEMIC MILESTONES -->
    <section class="section-container">
        <div class="section-tag">02 // TRACK RECORD</div>
        <h2 class="section-heading">Experience & Education</h2>

        <div class="milestone-log">

            <!-- Apploqic Technologies Internship -->
            <article class="milestone-entry">
                <div class="milestone-period">2026 – PRESENT</div>
                <div class="milestone-body">
                    <h3 class="milestone-role">Software Engineer Intern <span class="milestone-org">@ Apploqic Technologies</span></h3>
                    <p class="milestone-desc">
                        Engineering enterprise mobile applications (Client Quotation Estimator & Property Management) utilizing Flutter paired with decoupled Laravel REST API layers. Managing live production WordPress infrastructures, database optimizations, and client delivery pipelines.
                    </p>
                    <div class="tag-row">
                        <span class="mono-badge">Flutter</span>
                        <span class="mono-badge">Laravel API</span>
                        <span class="mono-badge">MySQL</span>
                        <span class="mono-badge">cPanel</span>
                    </div>
                </div>
            </article>

            <!-- Undergraduate Degree Card with CGPA, Dean's List, and Image -->
            <article class="milestone-entry">
                <div class="milestone-period">2022 – 2026</div>
                <div class="milestone-body">
                    <h3 class="milestone-role">Undergraduate Degree <span class="milestone-org">@ Universiti Malaysia Sabah</span></h3>
                    <p class="milestone-desc">
                        Underwent comprehensive software engineering training spanning system design patterns, algorithmic optimization, and data structures. Graduated with a <strong>3.76 CGPA</strong> and received <strong>7× Dean's List honors</strong>. Built ServeTogether as FYP and competed in the UM Hackathon AI track.
                    </p>

                    <div class="tag-row">
                        <span class="mono-badge">Distributed Systems</span>
                        <span class="mono-badge">Full-Stack Web</span>
                        <span class="mono-badge">Machine Learning</span>
                    </div>

                    <!-- Credential / Academic Image -->
                    <div class="academic-image-container">
                        <img 
                            src="/academics.png" 
                            alt="Teo Jun Cheng Academic Honors & Dean's List Record" 
                            class="academic-img"
                            onerror="this.parentElement.classList.add('img-placeholder');"
                        />
                    </div>
                </div>
            </article>

        </div>
    </section>

    <!-- 3. EMBEDDED CURRICULUM VITAE -->
    <section class="section-container" style="margin-bottom: 6rem;">
        <div class="section-tag">03 // RESUME</div>
        <h2 class="section-heading">Curriculum Vitae</h2>

        <div class="pdf-viewer-card">
            <div class="pdf-header">
                <div class="pdf-file-details">
                    <span class="terminal-symbol">$</span>
                    <span class="file-title">Teo_Jun_Cheng_Resume.pdf</span>
                </div>
                <div class="pdf-actions">
                    <a href="/Resume.pdf" target="_blank" class="viewer-btn">Open in New Tab ↗</a>
                    <a href="/Resume.pdf" download="Teo_Jun_Cheng_Resume.pdf" class="viewer-btn viewer-btn-highlight">Download</a>
                </div>
            </div>
            <iframe 
                src="/Resume.pdf" 
                class="pdf-display"
                title="Teo Jun Cheng Curriculum Vitae">
            </iframe>
        </div>
    </section>

</Layout>

<style>
    /* Hero */
    .career-hero {
        padding: 5rem 0 3.5rem;
        max-width: 860px;
    }

    .section-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #10b981;
        letter-spacing: 0.1em;
        margin-bottom: 0.75rem;
    }

    .hero-title {
        font-size: 2.85rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.2;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }

    .gradient-text {
        background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-intro {
        color: #94a3b8;
        font-size: 1.15rem;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.6rem;
        border-radius: 6px;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-emerald {
        background-color: #10b981;
        color: #022c22;
    }

    .btn-emerald:hover {
        background-color: #34d399;
        transform: translateY(-2px);
        box-shadow: 0 4px 18px rgba(16, 185, 129, 0.3);
    }

    .btn-ghost {
        background-color: #0f172a;
        color: #cbd5e1;
        border: 1px solid #1e293b;
    }

    .btn-ghost:hover {
        border-color: #10b981;
        color: #ffffff;
    }

    /* Section Structure */
    .section-container {
        margin-bottom: 5.5rem;
    }

    .section-heading {
        font-size: 1.85rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.02em;
        margin-bottom: 2rem;
    }

    /* Milestone Entries (Exact Trajectory Design) */
    .milestone-log {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .milestone-entry {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2rem;
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 2rem;
        transition: border-color 0.2s ease;
    }

    .milestone-entry:hover {
        border-color: #10b981;
    }

    @media (max-width: 768px) {
        .milestone-entry {
            grid-template-columns: 1fr;
            gap: 0.75rem;
            padding: 1.5rem;
        }
    }

    .milestone-period {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9rem;
        color: #10b981;
        font-weight: 600;
    }

    .milestone-role {
        color: #ffffff;
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .milestone-org {
        color: #94a3b8;
        font-weight: 400;
    }

    .milestone-desc {
        color: #94a3b8;
        font-size: 0.95rem;
        line-height: 1.7;
        margin-bottom: 1.25rem;
    }

    .milestone-desc strong {
        color: #34d399;
    }

    .tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .mono-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        background-color: #162032;
        color: #94a3b8;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        border: 1px solid #223249;
    }

    /* Embedded Academic Image */
    .academic-image-container {
        width: 100%;
        max-height: 480px;
        background-color: #090d16;
        border: 1px solid #162032;
        border-radius: 6px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .academic-img {
        width: 100%;
        height: auto;
        max-height: 480px;
        object-fit: contain;
        display: block;
    }

    .img-placeholder::after {
        content: "Place academic photo or transcript in public/academics.png";
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: #64748b;
        padding: 3rem 1rem;
        display: block;
    }

    /* PDF Viewer */
    .pdf-viewer-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        overflow: hidden;
    }

    .pdf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #090d16;
        border-bottom: 1px solid #1e293b;
        padding: 0.85rem 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .pdf-file-details {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
    }

    .terminal-symbol {
        color: #10b981;
    }

    .file-title {
        color: #cbd5e1;
    }

    .pdf-actions {
        display: flex;
        gap: 0.5rem;
    }

    .viewer-btn {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        text-decoration: none;
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        background-color: #162032;
        color: #cbd5e1;
        border: 1px solid #223249;
        transition: all 0.2s ease;
    }

    .viewer-btn:hover {
        background-color: #1e293b;
        color: #ffffff;
    }

    .viewer-btn-highlight {
        background-color: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border-color: rgba(16, 185, 129, 0.35);
    }

    .viewer-btn-highlight:hover {
        background-color: #10b981;
        color: #022c22;
    }

    .pdf-display {
        width: 100%;
        height: 750px;
        border: none;
        background-color: #ffffff;
    }
</style>
