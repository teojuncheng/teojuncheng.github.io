---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Teo Jun Cheng">

    <!-- 1. HERO HEADER -->
    <header class="contact-hero">
        <div class="terminal-tag">// GET IN TOUCH</div>
        <h1 class="page-title">Let's <span class="highlight">Connect</span></h1>
        <p class="hero-intro">
            Whether you have an inquiry, project collaboration, or full-time opportunity — my inbox is always open.
        </p>

        <div class="status-pill">
            <span class="status-pulse"></span>
            Open to Full-Time Software Engineering Roles (Starting Sept 2026)
        </div>
    </header>

    <div class="divider"></div>

    <!-- 2. CONTACT CHANNELS -->
    <section class="content-section">
        <div class="terminal-tag">// DIRECT CHANNELS</div>
        <h2 class="section-heading">Reach Out</h2>

        <div class="contact-grid">
            <!-- Email -->
            <a href="mailto:teojuncheng11@gmail.com" class="contact-card">
                <div class="card-icon">✉️</div>
                <div class="card-content">
                    <h3 class="card-title">Email</h3>
                    <p class="card-handle">teojuncheng11@gmail.com</p>
                    <p class="card-desc">Best for recruitment inquiries and formal discussions.</p>
                </div>
                <span class="card-arrow">↗</span>
            </a>

            <!-- LinkedIn -->
            <a href="https://linkedin.com/in/teo-jun-cheng" target="_blank" rel="noopener noreferrer" class="contact-card">
                <div class="card-icon">💼</div>
                <div class="card-content">
                    <h3 class="card-title">LinkedIn</h3>
                    <p class="card-handle">in/teo-jun-cheng</p>
                    <p class="card-desc">Let's connect professionally and discuss industry tech.</p>
                </div>
                <span class="card-arrow">↗</span>
            </a>

            <!-- GitHub -->
            <a href="https://github.com/teojuncheng" target="_blank" rel="noopener noreferrer" class="contact-card">
                <div class="card-icon">💻</div>
                <div class="card-content">
                    <h3 class="card-title">GitHub</h3>
                    <p class="card-handle">@teojuncheng</p>
                    <p class="card-desc">Explore source code repositories, commits, and builds.</p>
                </div>
                <span class="card-arrow">↗</span>
            </a>
        </div>
    </section>

    <!-- 3. LOCATION & QUICK INFO -->
    <section class="content-section" style="margin-bottom: 5rem;">
        <div class="terminal-tag">// DETAILS</div>
        <h2 class="section-heading">Location & Timezone</h2>

        <div class="info-box">
            <div class="info-item">
                <span class="info-label">PRIMARY LOCATION</span>
                <span class="info-value">Kuala Lumpur / Kota Kinabalu, Malaysia</span>
            </div>
            <div class="info-item">
                <span class="info-label">TIMEZONE</span>
                <span class="info-value">MYT (UTC+8)</span>
            </div>
            <div class="info-item">
                <span class="info-label">RESPONSE TIME</span>
                <span class="info-value">Within 24 Hours</span>
            </div>
        </div>
    </section>

</Layout>

<style>
    /* Header */
    .contact-hero {
        padding: 5rem 0 2rem;
        max-width: 820px;
    }

    .terminal-tag {
        font-family: 'JetBrains Mono', monospace;
        color: #38bdf8;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        letter-spacing: 0.05em;
    }

    .page-title {
        font-size: 3.25rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.15;
        margin-bottom: 1.25rem;
        letter-spacing: -0.03em;
    }

    .highlight {
        color: #38bdf8;
    }

    .hero-intro {
        color: #94a3b8;
        font-size: 1.15rem;
        line-height: 1.7;
        margin-bottom: 1.75rem;
    }

    /* Status Pill */
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background-color: rgba(34, 197, 94, 0.12);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.3);
        padding: 0.45rem 1rem;
        border-radius: 9999px;
        font-size: 0.88rem;
        font-weight: 600;
    }

    .status-pulse {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #4ade80;
        box-shadow: 0 0 10px #4ade80;
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.9); }
        100% { opacity: 1; transform: scale(1); }
    }

    .divider {
        height: 1px;
        background-color: #1e293b;
        margin: 2.5rem 0 3.5rem;
    }

    /* Content Sections */
    .content-section {
        margin-bottom: 4.5rem;
    }

    .section-heading {
        font-size: 2rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 2rem;
        letter-spacing: -0.02em;
    }

    /* Contact Cards */
    .contact-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .contact-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 1.75rem;
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
        text-decoration: none;
        position: relative;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .contact-card:hover {
        border-color: #38bdf8;
        transform: translateY(-2px);
    }

    .card-icon {
        font-size: 2rem;
        line-height: 1;
    }

    .card-content {
        flex: 1;
    }

    .card-title {
        color: #ffffff;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .card-handle {
        font-family: 'JetBrains Mono', monospace;
        color: #38bdf8;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .card-desc {
        color: #94a3b8;
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .card-arrow {
        color: #475569;
        font-size: 1.2rem;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .contact-card:hover .card-arrow {
        color: #38bdf8;
        transform: translate(2px, -2px);
    }

    /* Info Box */
    .info-box {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 2rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 2rem;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .info-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #38bdf8;
        font-weight: 700;
        letter-spacing: 0.05em;
    }

    .info-value {
        color: #f8fafc;
        font-size: 1rem;
        font-weight: 500;
    }
</style>
