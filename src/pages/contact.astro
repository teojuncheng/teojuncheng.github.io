---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Teo Jun Cheng">

    <!-- 1. EDITORIAL HEADER -->
    <header class="contact-hero">
        <div class="section-tag">01 // INQUIRIES</div>
        <h1 class="hero-title">Initiate <span class="gradient-text">Communication</span>.</h1>
        <p class="hero-intro">
            Whether evaluating my profile for full-time engineering roles, technical consultations, or project collaborations — reach out via any channel below.
        </p>
        
        <!-- Live Status Bar -->
        <div class="availability-indicator">
            <span class="pulse-emerald"></span>
            <span>AVAILABLE FOR FULL-TIME HIRE (STARTING SEPT 2026)</span>
        </div>
    </header>

    <!-- 2. DIRECT ACCESS CHANNELS -->
    <section class="section-block">
        <div class="section-tag">02 // TRANSMISSION</div>
        <h2 class="section-heading">Direct Channels</h2>

        <div class="channels-grid">
            
            <!-- Email Transmission -->
            <a href="mailto:teojuncheng11@gmail.com" class="channel-card">
                <div class="channel-top">
                    <span class="channel-icon">✉️</span>
                    <span class="channel-type">DIRECT MAIL</span>
                </div>
                <h3 class="channel-name">teojuncheng11@gmail.com</h3>
                <p class="channel-desc">Preferred route for formal job opportunities, technical inquiries, and project specifications.</p>
                <div class="channel-action">
                    <span>Send Message</span>
                    <span class="arrow-sym">↗</span>
                </div>
            </a>

            <!-- LinkedIn Profile -->
            <a href="https://linkedin.com/in/teo-jun-cheng" target="_blank" rel="noopener noreferrer" class="channel-card">
                <div class="channel-top">
                    <span class="channel-icon">💼</span>
                    <span class="channel-type">PROFESSIONAL NETWORK</span>
                </div>
                <h3 class="channel-name">linkedin.com/in/teo-jun-cheng</h3>
                <p class="channel-desc">Connect for industry updates, professional recommendations, and tech dialogue.</p>
                <div class="channel-action">
                    <span>Open Profile</span>
                    <span class="arrow-sym">↗</span>
                </div>
            </a>

            <!-- GitHub Repositories -->
            <a href="https://github.com/teojuncheng" target="_blank" rel="noopener noreferrer" class="channel-card">
                <div class="channel-top">
                    <span class="channel-icon">💻</span>
                    <span class="channel-type">CODE VAULT</span>
                </div>
                <h3 class="channel-name">github.com/teojuncheng</h3>
                <p class="channel-desc">Review source code commits, application structures, and architecture experiments.</p>
                <div class="channel-action">
                    <span>Explore Repos</span>
                    <span class="arrow-sym">↗</span>
                </div>
            </a>

        </div>
    </section>

    <!-- 3. PARAMETERS & RESPONSE TIME -->
    <section class="section-block" style="margin-bottom: 6rem;">
        <div class="section-tag">03 // PROTOCOLS</div>
        <h2 class="section-heading">Operational Parameters</h2>

        <div class="specs-panel">
            <div class="spec-col">
                <span class="spec-label">BASE LOCATION</span>
                <span class="spec-val">Kuala Lumpur / Kota Kinabalu, MY</span>
                <span class="spec-detail">Open to local hybrid/on-site & remote roles</span>
            </div>
            
            <div class="spec-col">
                <span class="spec-label">PRIMARY TIMEZONE</span>
                <span class="spec-val">Malaysia Time (MYT • UTC+8)</span>
                <span class="spec-detail">Active core development hours</span>
            </div>

            <div class="spec-col">
                <span class="spec-label">EXPECTED RESPONSE</span>
                <span class="spec-val text-emerald">&lt; 24 Hours</span>
                <span class="spec-detail">Direct email response guaranteed</span>
            </div>
        </div>
    </section>

</Layout>

<style>
    /* Hero */
    .contact-hero {
        padding: 5rem 0 2.5rem;
        max-width: 860px;
    }

    .section-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #10b981;
        letter-spacing: 0.1em;
        margin-bottom: 0.75rem;
    }

    .hero-title {
        font-size: 2.85rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.2;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }

    .gradient-text {
        background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-intro {
        color: #94a3b8;
        font-size: 1.15rem;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    /* Availability Indicator */
    .availability-indicator {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        letter-spacing: 0.06em;
        background-color: rgba(16, 185, 129, 0.1);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
        padding: 0.5rem 1rem;
        border-radius: 4px;
    }

    .pulse-emerald {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #10b981;
        box-shadow: 0 0 10px #10b981;
        animation: beacon 2s infinite ease-in-out;
    }

    @keyframes beacon {
        0% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.35; transform: scale(0.85); }
        100% { opacity: 1; transform: scale(1); }
    }

    /* Section Structure */
    .section-block {
        margin-top: 3.5rem;
        margin-bottom: 5rem;
    }

    .section-heading {
        font-size: 1.85rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.02em;
        margin-bottom: 2rem;
    }

    /* Channels Grid */
    .channels-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: 1.5rem;
    }

    .channel-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-decoration: none;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .channel-card:hover {
        border-color: #10b981;
        transform: translateY(-2px);
    }

    .channel-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
    }

    .channel-icon {
        font-size: 1.75rem;
    }

    .channel-type {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: #64748b;
        letter-spacing: 0.08em;
    }

    .channel-name {
        color: #ffffff;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        word-break: break-all;
    }

    .channel-desc {
        color: #94a3b8;
        font-size: 0.92rem;
        line-height: 1.6;
        margin-bottom: 1.75rem;
    }

    .channel-action {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: #10b981;
        font-weight: 600;
        border-top: 1px solid #162032;
        padding-top: 1rem;
    }

    .arrow-sym {
        transition: transform 0.2s ease;
    }

    .channel-card:hover .arrow-sym {
        transform: translate(3px, -3px);
    }

    /* Specs Panel */
    .specs-panel {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 2rem;
    }

    .spec-col {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .spec-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #10b981;
        letter-spacing: 0.06em;
    }

    .spec-val {
        color: #f1f5f9;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .spec-detail {
        color: #64748b;
        font-size: 0.85rem;
    }

    .text-emerald {
        color: #34d399 !important;
    }
</style>
