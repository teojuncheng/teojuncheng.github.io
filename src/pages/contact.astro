---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Teo Jun Cheng">
    <header class="page-header">
        <div class="terminal-prompt">ping teojuncheng</div>
        <h1>Let's Connect</h1>
        <p style="color: var(--text-secondary); max-width: 600px; margin-top: 0.5rem;">
            Whether you have an inquiry, full-time opportunity, or project collaboration—my inbox is open!
        </p>
    </header>

    <div style="display: inline-flex; align-items: center; gap: 0.5rem; background-color: rgba(16, 185, 129, 0.1); color: var(--accent-green); padding: 0.4rem 0.9rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-bottom: 2rem; border: 1px solid rgba(16, 185, 129, 0.3);">
        <span>●</span> Open to Full-Time Software Engineering Roles (Starting Sept 2026)[cite: 1]
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 4rem;">
        <a href="mailto:teojuncheng11@gmail.com" class="card" style="text-decoration: none;">
            <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">✉️</div>
            <h3 style="color:#fff; margin-bottom:0.25rem;">Email</h3>
            <p style="color:var(--accent-green); font-size:0.95rem; margin-bottom:0.5rem;">teojuncheng11@gmail.com[cite: 1]</p>
            <p style="color:var(--text-muted); font-size:0.85rem;">Best for formal inquiries and job opportunities.</p>
        </a>

        <a href="https://linkedin.com/in/teo-jun-cheng" target="_blank" class="card" style="text-decoration: none;">
            <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">💼</div>
            <h3 style="color:#fff; margin-bottom:0.25rem;">LinkedIn</h3>
            <p style="color:var(--accent-green); font-size:0.95rem; margin-bottom:0.5rem;">linkedin.com/in/teo-jun-cheng[cite: 1]</p>
            <p style="color:var(--text-muted); font-size:0.85rem;">Let's connect professionally.</p>
        </a>

        <a href="https://github.com/teojuncheng" target="_blank" class="card" style="text-decoration: none;">
            <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">💻</div>
            <h3 style="color:#fff; margin-bottom:0.25rem;">GitHub</h3>
            <p style="color:var(--accent-green); font-size:0.95rem; margin-bottom:0.5rem;">github.com/teojuncheng[cite: 1]</p>
            <p style="color:var(--text-muted); font-size:0.85rem;">Explore code repositories & contributions.</p>
        </a>
    </div>
</Layout>