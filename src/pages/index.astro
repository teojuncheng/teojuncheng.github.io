---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Teo Jun Cheng | Software Engineer">

    <!-- 1. SPLIT HERO SECTION WITH TERMINAL CARD -->
    <section class="hero-split">
        <div class="hero-intro">
            <div class="status-badge">
                <span class="pulse-indicator"></span>
                <span>SYSTEM ONLINE • OPEN TO ROLES (SEPT 2026)</span>
            </div>
            <h1 class="hero-headline">Engineering robust systems from <span class="gradient-text">backend to client</span>.</h1>
            <p class="hero-bio">
                I'm <strong>Teo Jun Cheng</strong>, a full-stack software engineer focused on building decoupled APIs, scalable mobile applications, and resilient digital architectures.
            </p>
            <div class="cta-row">
                <a href="/projects" class="btn btn-emerald">Explore Solutions →</a>
                <a href="/career" class="btn btn-ghost">View Credentials</a>
            </div>
        </div>

        <!-- Terminal Diagnostic Box -->
        <div class="console-box">
            <div class="console-top">
                <div class="window-controls">
                    <span class="win-dot close"></span>
                    <span class="win-dot minimize"></span>
                    <span class="win-dot maximize"></span>
                </div>
                <span class="console-title">env_profile.sh</span>
            </div>
            <div class="console-content">
                <p><span class="prompt">$</span> whoami</p>
                <p class="console-res">teo_jun_cheng --role "Software Engineer"</p>
                <p><span class="prompt">$</span> cat academics.json</p>
                <p class="console-res">&#123; "cgpa": 3.74, "awards": "6x Dean's List", "uni": "UMS" &#125;</p>
                <p><span class="prompt">$</span> check --internship</p>
                <p class="console-res text-emerald">Apploqic Technologies (Flutter / Laravel API)</p>
                <p><span class="prompt">$</span> locate</p>
                <p class="console-res">Kuala Lumpur / Kota Kinabalu, MY</p>
            </div>
        </div>
    </section>

    <!-- 2. METRIC TILES ROW -->
    <section class="metrics-grid">
        <div class="metric-card">
            <span class="metric-num">3.74</span>
            <span class="metric-label">Cumulative CGPA</span>
        </div>
        <div class="metric-card">
            <span class="metric-num">06</span>
            <span class="metric-label">Dean's List Honors</span>
        </div>
        <div class="metric-card">
            <span class="metric-num">100%</span>
            <span class="metric-label">Decoupled Architecture</span>
        </div>
        <div class="metric-card">
            <span class="metric-num text-emerald">2026</span>
            <span class="metric-label">Full-Time Availability</span>
        </div>
    </section>

    <!-- 3. DOMAIN EXPERTISE & TECH STACK -->
    <section class="section-container">
        <div class="section-tag">01 // DOMAIN EXPERTISE</div>
        <h2 class="section-title">Technical Capabilities</h2>

        <div class="stack-grid">
            <div class="stack-column">
                <div class="stack-col-header">
                    <span class="col-icon">⚡</span>
                    <h3>Core Languages</h3>
                </div>
                <div class="skill-pills">
                    <span class="skill-tag">Dart</span>
                    <span class="skill-tag">PHP</span>
                    <span class="skill-tag">Python</span>
                    <span class="skill-tag">JavaScript (ES6+)</span>
                    <span class="skill-tag">TypeScript</span>
                    <span class="skill-tag">Kotlin</span>
                    <span class="skill-tag">C# / C++</span>
                    <span class="skill-tag">SQL</span>
                </div>
            </div>

            <div class="stack-column">
                <div class="stack-col-header">
                    <span class="col-icon">🛠️</span>
                    <h3>Frameworks & Systems</h3>
                </div>
                <div class="skill-pills">
                    <span class="skill-tag featured-tag">Flutter</span>
                    <span class="skill-tag featured-tag">Laravel REST</span>
                    <span class="skill-tag">Astro SSG</span>
                    <span class="skill-tag">MySQL</span>
                    <span class="skill-tag">Git / GitHub Actions</span>
                    <span class="skill-tag">Unity VR</span>
                    <span class="skill-tag">cPanel / WordPress</span>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. HIGHLIGHTED BUILDS -->
    <section class="section-container">
        <div class="section-tag">02 // CASE STUDIES</div>
        <h2 class="section-title">Selected Engineering Projects</h2>

        <div class="projects-list">
            <!-- Project Card 1 -->
            <article class="project-entry">
                <div class="project-meta">
                    <span class="project-category">FULL STACK • FYP</span>
                    <h3 class="project-heading">ServeTogether — Smart Volunteer Platform</h3>
                    <p class="project-overview">
                        Engineered a centralized volunteer management web platform equipped with dynamic recommendation algorithms to match participant preferences with active service initiatives.
                    </p>
                    <div class="tech-inline">
                        <span>PHP</span> • <span>MySQL</span> • <span>JavaScript</span> • <span>CSS3</span>
                    </div>
                </div>
                <div class="project-action-link">
                    <a href="/projects" class="inline-arrow-btn">Read Case Study ↗</a>
                </div>
            </article>

            <!-- Project Card 2 -->
            <article class="project-entry">
                <div class="project-meta">
                    <span class="project-category">MOBILE CLIENT • APPLOQIC</span>
                    <h3 class="project-heading">Client Quotation & Estimator Engine</h3>
                    <p class="project-overview">
                        A decoupled mobile application allowing corporate clients to build service specifications, receive instantaneous rate estimates, and securely post requests to remote Laravel APIs.
                    </p>
                    <div class="tech-inline">
                        <span>Flutter</span> • <span>Dart</span> • <span>Laravel REST</span> • <span>MySQL</span>
                    </div>
                </div>
                <div class="project-action-link">
                    <a href="/projects" class="inline-arrow-btn">Read Case Study ↗</a>
                </div>
            </article>
        </div>
    </section>

    <!-- 5. DIRECT NAVIGATION PANELS -->
    <section class="section-container" style="margin-bottom: 6rem;">
        <div class="section-tag">03 // INDEX</div>
        <h2 class="section-title">Directory Navigation</h2>

        <div class="nav-grid-boxes">
            <a href="/about" class="nav-box">
                <div class="nav-box-header">
                    <span class="nav-box-num">01</span>
                    <span class="nav-arrow">→</span>
                </div>
                <h4 class="nav-box-title">About Me</h4>
                <p class="nav-box-sub">Philosophy, background, education, and lifestyle pursuits.</p>
            </a>

            <a href="/projects" class="nav-box">
                <div class="nav-box-header">
                    <span class="nav-box-num">02</span>
                    <span class="nav-arrow">→</span>
                </div>
                <h4 class="nav-box-title">All Projects</h4>
                <p class="nav-box-sub">Full repository index, hackathon projects, and application specs.</p>
            </a>

            <a href="/career" class="nav-box">
                <div class="nav-box-header">
                    <span class="nav-box-num">03</span>
                    <span class="nav-arrow">→</span>
                </div>
                <h4 class="nav-box-title">Career & CV</h4>
                <p class="nav-box-sub">Professional internship history, milestones, and embedded resume.</p>
            </a>

            <a href="/contact" class="nav-box">
                <div class="nav-box-header">
                    <span class="nav-box-num">04</span>
                    <span class="nav-arrow">→</span>
                </div>
                <h4 class="nav-box-title">Get In Touch</h4>
                <p class="nav-box-sub">Direct communication channels, links, and meeting inquiries.</p>
            </a>
        </div>
    </section>

</Layout>

<style>
    /* Split Hero */
    .hero-split {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 3rem;
        align-items: center;
        padding: 4.5rem 0 3.5rem;
    }

    @media (max-width: 860px) {
        .hero-split {
            grid-template-columns: 1fr;
            gap: 2rem;
            padding: 3rem 0;
        }
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        background-color: rgba(16, 185, 129, 0.1);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.25);
        padding: 0.35rem 0.85rem;
        border-radius: 4px;
        margin-bottom: 1.25rem;
    }

    .pulse-indicator {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: #10b981;
        box-shadow: 0 0 8px #10b981;
    }

    .hero-headline {
        font-size: 2.75rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.18;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }

    .gradient-text {
        background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-bio {
        color: #94a3b8;
        font-size: 1.05rem;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .hero-bio strong {
        color: #f1f5f9;
    }

    .cta-row {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.6rem;
        border-radius: 6px;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-emerald {
        background-color: #10b981;
        color: #022c22;
    }

    .btn-emerald:hover {
        background-color: #34d399;
        transform: translateY(-2px);
        box-shadow: 0 4px 18px rgba(16, 185, 129, 0.3);
    }

    .btn-ghost {
        background-color: #0f172a;
        color: #cbd5e1;
        border: 1px solid #1e293b;
    }

    .btn-ghost:hover {
        border-color: #10b981;
        color: #ffffff;
    }

    /* Console Card */
    .console-box {
        background-color: #090d16;
        border: 1px solid #1e293b;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .console-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: #0f172a;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid #1e293b;
    }

    .window-controls {
        display: flex;
        gap: 6px;
    }

    .win-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .close { background-color: #ef4444; }
    .minimize { background-color: #f59e0b; }
    .maximize { background-color: #10b981; }

    .console-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #64748b;
    }

    .console-content {
        padding: 1.25rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.84rem;
        color: #cbd5e1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .prompt {
        color: #10b981;
        font-weight: bold;
    }

    .console-res {
        color: #94a3b8;
        padding-left: 0.85rem;
        border-left: 2px solid #1e293b;
        margin-bottom: 0.4rem;
    }

    .text-emerald {
        color: #34d399 !important;
    }

    /* Metrics Row */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1.25rem;
        margin-bottom: 5rem;
    }

    .metric-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .metric-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 2.2rem;
        font-weight: 800;
        color: #f8fafc;
    }

    .metric-label {
        font-size: 0.85rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Section Layout */
    .section-container {
        margin-bottom: 5rem;
    }

    .section-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #10b981;
        letter-spacing: 0.1em;
        margin-bottom: 0.5rem;
    }

    .section-title {
        font-size: 1.9rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 2rem;
        letter-spacing: -0.02em;
    }

    /* Domain / Stack Grid */
    .stack-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .stack-column {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 1.75rem;
    }

    .stack-col-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #1e293b;
    }

    .stack-col-header h3 {
        font-size: 1.1rem;
        color: #ffffff;
    }

    .skill-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .skill-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        background-color: #162032;
        color: #cbd5e1;
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        border: 1px solid #223249;
    }

    .featured-tag {
        border-color: rgba(16, 185, 129, 0.4);
        color: #34d399;
    }

    /* Selected Projects */
    .projects-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .project-entry {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        transition: border-color 0.2s ease;
    }

    .project-entry:hover {
        border-color: #10b981;
    }

    @media (max-width: 768px) {
        .project-entry {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    .project-category {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #10b981;
        letter-spacing: 0.08em;
    }

    .project-heading {
        font-size: 1.35rem;
        color: #ffffff;
        margin: 0.35rem 0 0.75rem;
    }

    .project-overview {
        color: #94a3b8;
        font-size: 0.95rem;
        line-height: 1.6;
        max-width: 650px;
        margin-bottom: 1rem;
    }

    .tech-inline {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #64748b;
    }

    .tech-inline span {
        color: #cbd5e1;
    }

    .inline-arrow-btn {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.88rem;
        color: #10b981;
        text-decoration: none;
        white-space: nowrap;
        font-weight: 600;
        padding: 0.6rem 1rem;
        border-radius: 4px;
        border: 1px solid rgba(16, 185, 129, 0.3);
        transition: all 0.2s ease;
    }

    .inline-arrow-btn:hover {
        background-color: rgba(16, 185, 129, 0.1);
        border-color: #10b981;
    }

    /* Navigation Grid */
    .nav-grid-boxes {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 1.25rem;
    }

    .nav-box {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 1.5rem;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .nav-box:hover {
        border-color: #10b981;
        transform: translateY(-2px);
    }

    .nav-box-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .nav-box-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #64748b;
    }

    .nav-arrow {
        color: #10b981;
        font-size: 1.1rem;
        transition: transform 0.2s ease;
    }

    .nav-box:hover .nav-arrow {
        transform: translateX(3px);
    }

    .nav-box-title {
        color: #ffffff;
        font-size: 1.1rem;
        margin-bottom: 0.35rem;
    }

    .nav-box-sub {
        color: #94a3b8;
        font-size: 0.85rem;
        line-height: 1.5;
    }
</style>
