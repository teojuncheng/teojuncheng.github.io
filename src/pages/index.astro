---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Teo Jun Cheng | Software Engineer">

    <!-- 1. SPLIT HERO SECTION WITH ABOUT ME DOSSIER CARD -->
    <section class="hero-split">
        <div class="hero-intro">
            <h1 class="hero-headline">Engineering robust systems from <span class="gradient-text">backend to client</span>.</h1>
            <p class="hero-bio">
                I'm <strong>Teo Jun Cheng</strong>, a full-stack software engineer focused on building decoupled APIs, scalable mobile applications, and resilient financial & digital architectures.
            </p>
            <div class="cta-row">
                <a href="/projects" class="btn btn-emerald">Explore Projects →</a>
                <a href="/career" class="btn btn-ghost">View Experience</a>
            </div>
        </div>

        <!-- About Me Dossier Card -->
        <div class="about-card">
            <div class="about-card-header">
                <div class="card-title-group">
                    <span class="card-icon">⚡</span>
                    <span class="card-heading-text">About Me</span>
                </div>
                <span class="card-status-pill">AVAILABLE</span>
            </div>
            
            <ul class="about-points">
                <li>
                    <span class="point-emoji">🎓</span>
                    <span><strong>Software Engineering graduate</strong> from Universiti Malaysia Sabah (3.76 CGPA • 7× Dean's List).</span>
                </li>
                <li>
                    <span class="point-emoji">🚀</span>
                    <span><strong>Full-Stack & Mobile Engineer</strong> specialized in decoupled REST APIs and cross-platform clients.</span>
                </li>
                <li>
                    <span class="point-emoji">📈</span>
                    <span><strong>Targeting the Fintech space</strong>, actively building quantitative screening tools and computational backends.</span>
                </li>
                <li>
                    <span class="point-emoji">🛠️</span>
                    <span><strong>Production-tested</strong> with Flutter, Dart, and Laravel API integration during industry internship.</span>
                </li>
                <li>
                    <span class="point-emoji">🔍</span>
                    <span><strong>Systematic thinker</strong> focused on modular architectures and relational schema integrity (MySQL/PostgreSQL).</span>
                </li>
                <li>
                    <span class="point-emoji">💼</span>
                    <span><strong>Open to full-time roles</strong> and high-impact technical collaborations.</span>
                </li>
            </ul>
        </div>
    </section>

    <!-- 2. ENGINEERING PHILOSOPHY -->
    <section class="section-container">
        <div class="section-tag">01 // DOSSIER</div>
        <h2 class="section-title">Engineering Philosophy</h2>

        <div class="philosophy-card">
            <div class="card-kicker">CORE PHILOSOPHY</div>
            <h3 class="card-heading">Architecting for reliability, scale, and clarity.</h3>
            <p class="card-body">
                I treat software development as an exercise in structural precision. Rather than stitching hasty implementations together, I specialize in architecting decoupled systems — ensuring API interfaces remain independent, predictable, and resilient under production loads.
            </p>
            <div class="core-focus-list">
                <span class="focus-item">✦ Decoupled REST APIs</span>
                <span class="focus-item">✦ Cross-Platform Mobile (Flutter)</span>
                <span class="focus-item">✦ Relational Schemas (MySQL)</span>
            </div>
        </div>
    </section>

    <!-- 3. TECHNICAL CAPABILITIES / SKILLS -->
    <section class="section-container">
        <div class="section-tag">02 // DOMAIN EXPERTISE</div>
        <h2 class="section-title">Skills & Capabilities</h2>

        <div class="skills-grid">
            <!-- Programming Languages -->
            <div class="skill-card">
                <div class="skill-icon-wrap">
                    <svg class="skill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 18 22 12 16 6"></polyline>
                        <polyline points="8 6 2 12 8 18"></polyline>
                    </svg>
                </div>
                <div class="skill-info">
                    <h3 class="skill-category">Programming Languages</h3>
                    <p class="skill-items">PHP, Dart, Kotlin, Python, JavaScript, TypeScript, C#, C++, Java</p>
                </div>
            </div>

            <!-- Frameworks & UI -->
            <div class="skill-card">
                <div class="skill-icon-wrap">
                    <svg class="skill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                </div>
                <div class="skill-info">
                    <h3 class="skill-category">Frameworks & UI</h3>
                    <p class="skill-items">Laravel, FastAPI, Tailwind CSS, Flutter, React, Next.js, Jetpack Compose</p>
                </div>
            </div>

            <!-- Databases -->
            <div class="skill-card">
                <div class="skill-icon-wrap">
                    <svg class="skill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                    </svg>
                </div>
                <div class="skill-info">
                    <h3 class="skill-category">Databases</h3>
                    <p class="skill-items">MySQL, PostgreSQL</p>
                </div>
            </div>

            <!-- Tools, Platforms & CMS -->
            <div class="skill-card">
                <div class="skill-icon-wrap">
                    <svg class="skill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                </div>
                <div class="skill-info">
                    <h3 class="skill-category">Tools, Platforms & CMS</h3>
                    <p class="skill-items">Git, Docker, cPanel, WordPress, Vercel, Render, Postman / REST APIs, Unity</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. PERSONAL PURSUITS (BEYOND CODE) -->
    <section class="section-container">
        <div class="section-tag">03 // DIMENSIONS</div>
        <h2 class="section-title">Discipline & Pursuits Outside the Terminal</h2>

        <div class="pursuits-grid">
            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">🏃‍♂️</span>
                    <span class="pursuit-tag">ENDURANCE</span>
                </div>
                <h3 class="pursuit-title">Distance Running</h3>
                <p class="pursuit-desc">Structured long-distance training to build sustained physical stamina, mental endurance, and everyday discipline.</p>
            </div>

            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">🎮</span>
                    <span class="pursuit-tag">STRATEGY</span>
                </div>
                <h3 class="pursuit-title">Tactical Gaming</h3>
                <p class="pursuit-desc">Deep-dive RPG systems, emulation engineering, and complex decision-tree game theory.</p>
            </div>

            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">📊</span>
                    <span class="pursuit-tag">ANALYTICS</span>
                </div>
                <h3 class="pursuit-title">Personal Finance</h3>
                <p class="pursuit-desc">Quantitative asset valuation modeling, macro analysis, and custom-scripted portfolio tracking tools.</p>
            </div>

            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">⛩️</span>
                    <span class="pursuit-tag">CULTURE</span>
                </div>
                <h3 class="pursuit-title">Japanese Language</h3>
                <p class="pursuit-desc">Consistently studying Kanji and grammar structures to broaden cross-cultural communication fluency.</p>
            </div>
        </div>
    </section>

    <!-- 5. GUIDING AXIOMS -->
    <section class="section-container" style="margin-bottom: 6rem;">
        <div class="section-tag">04 // PRINCIPLES</div>
        <h2 class="section-title">Guiding Axioms</h2>

        <div class="axioms-grid">
            <div class="axiom-box">
                <p class="axiom-quote">"Yesterday is history, tomorrow is a mystery, but today is a gift. That is why it is called the present."</p>
                <span class="axiom-meta">— Master Oogway</span>
            </div>
            <div class="axiom-box">
                <p class="axiom-quote">"If you only do what you can do, you will never be more than who you are."</p>
                <span class="axiom-meta">— Master Shifu</span>
            </div>
        </div>
    </section>

</Layout>

<style>
    /* Split Hero */
    .hero-split {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: 3rem;
        align-items: center;
        padding: 5rem 0 4rem;
    }

    @media (max-width: 900px) {
        .hero-split {
            grid-template-columns: 1fr;
            gap: 2.5rem;
            padding: 3rem 0;
        }
    }

    .hero-headline {
        font-size: 2.75rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.18;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }

    .gradient-text {
        background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-bio {
        color: #94a3b8;
        font-size: 1.05rem;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .hero-bio strong {
        color: #f1f5f9;
    }

    .cta-row {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.6rem;
        border-radius: 6px;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-emerald {
        background-color: #10b981;
        color: #022c22;
    }

    .btn-emerald:hover {
        background-color: #34d399;
        transform: translateY(-2px);
        box-shadow: 0 4px 18px rgba(16, 185, 129, 0.3);
    }

    .btn-ghost {
        background-color: #0f172a;
        color: #cbd5e1;
        border: 1px solid #1e293b;
    }

    .btn-ghost:hover {
        border-color: #10b981;
        color: #ffffff;
    }

    /* About Me Dossier Card */
    .about-card {
        background-color: #090d16;
        border: 1px solid #1e293b;
        border-radius: 10px;
        padding: 1.75rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        transition: border-color 0.2s ease;
    }

    .about-card:hover {
        border-color: rgba(16, 185, 129, 0.5);
    }

    .about-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #162032;
        padding-bottom: 1rem;
    }

    .card-title-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-icon {
        color: #10b981;
        font-size: 1rem;
    }

    .card-heading-text {
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -0.01em;
    }

    .card-status-pill {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        background-color: rgba(16, 185, 129, 0.1);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        font-weight: 600;
    }

    .about-points {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
    }

    .about-points li {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        color: #94a3b8;
        font-size: 0.88rem;
        line-height: 1.55;
    }

    .about-points li strong {
        color: #f1f5f9;
    }

    .point-emoji {
        font-size: 1rem;
        line-height: 1.4;
        flex-shrink: 0;
    }

    /* Section Layout */
    .section-container {
        margin-bottom: 5rem;
    }

    .section-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #10b981;
        letter-spacing: 0.1em;
        margin-bottom: 0.5rem;
    }

    .section-title {
        font-size: 1.9rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 2rem;
        letter-spacing: -0.02em;
    }

    /* Philosophy Card */
    .philosophy-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2.25rem;
        display: flex;
        flex-direction: column;
    }

    .card-kicker {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #10b981;
        letter-spacing: 0.08em;
        margin-bottom: 1rem;
    }

    .card-heading {
        color: #ffffff;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.4;
        margin-bottom: 1rem;
    }

    .card-body {
        color: #94a3b8;
        font-size: 0.96rem;
        line-height: 1.7;
        margin-bottom: 1.75rem;
    }

    .core-focus-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .focus-item {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #cbd5e1;
        background-color: #162032;
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        border: 1px solid #223249;
    }

    /* Skills Grid */
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    @media (max-width: 768px) {
        .skills-grid {
            grid-template-columns: 1fr;
        }
    }

    .skill-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 10px;
        padding: 1.75rem 2rem;
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .skill-card:hover {
        border-color: #10b981;
        transform: translateY(-2px);
    }

    .skill-icon-wrap {
        width: 44px;
        height: 44px;
        background-color: rgba(245, 158, 11, 0.08);
        border: 1px solid rgba(245, 158, 11, 0.2);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .skill-icon {
        width: 22px;
        height: 22px;
        color: #f59e0b;
    }

    .skill-info {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .skill-category {
        color: #ffffff;
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.01em;
    }

    .skill-items {
        color: #94a3b8;
        font-size: 0.92rem;
        line-height: 1.6;
        margin: 0;
    }

    /* Pursuits Grid */
    .pursuits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.25rem;
    }

    .pursuit-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .pursuit-card:hover {
        transform: translateY(-2px);
        border-color: #10b981;
    }

    .pursuit-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .pursuit-icon {
        font-size: 1.5rem;
    }

    .pursuit-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: #10b981;
        background-color: rgba(16, 185, 129, 0.1);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        letter-spacing: 0.05em;
    }

    .pursuit-title {
        color: #ffffff;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .pursuit-desc {
        color: #94a3b8;
        font-size: 0.88rem;
        line-height: 1.6;
    }

    /* Axioms (2-Card Grid) */
    .axioms-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .axiom-box {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-left: 3px solid #10b981;
        border-radius: 6px;
        padding: 1.75rem 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.25rem;
    }

    .axiom-quote {
        color: #e2e8f0;
        font-size: 1.05rem;
        font-style: italic;
        line-height: 1.7;
    }

    .axiom-meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.82rem;
        color: #10b981;
        font-weight: 600;
    }
</style>
