---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Teo Jun Cheng | Software Engineer">

    <!-- 1. SPLIT HERO SECTION WITH TERMINAL CARD -->
    <section class="hero-split">
        <div class="hero-intro">
            <h1 class="hero-headline">Engineering robust systems from <span class="gradient-text">backend to client</span>.</h1>
            <p class="hero-bio">
                I'm <strong>Teo Jun Cheng</strong>, a full-stack software engineer focused on building decoupled APIs, scalable mobile applications, and resilient digital architectures.
            </p>
            <div class="cta-row">
                <a href="/projects" class="btn btn-emerald">Explore Projects →</a>
                <a href="/career" class="btn btn-ghost">View Experience</a>
            </div>
        </div>

        <!-- Terminal Diagnostic Box -->
        <div class="console-box">
            <div class="console-top">
                <div class="window-controls">
                    <span class="win-dot close"></span>
                    <span class="win-dot minimize"></span>
                    <span class="win-dot maximize"></span>
                </div>
                <span class="console-title">env_profile.sh</span>
            </div>
            <div class="console-content">
                <p><span class="prompt">$</span> whoami</p>
                <p class="console-res">teo_jun_cheng --role "Software Engineer"</p>
                <p><span class="prompt">$</span> contact --email</p>
                <p class="console-res">teojuncheng11@gmail.com</p>
                <p><span class="prompt">$</span> contact --phone</p>
                <p class="console-res text-emerald">+6016-8449036</p>
                <p><span class="prompt">$</span> locate</p>
                <p class="console-res">Kuala Lumpur / Kota Kinabalu, MY</p>
            </div>
        </div>
    </section>

    <!-- 2. ENGINEERING PHILOSOPHY -->
    <section class="section-container">
        <div class="section-tag">01 // DOSSIER</div>
        <h2 class="section-title">Engineering Philosophy</h2>

        <div class="philosophy-card">
            <div class="card-kicker">CORE PHILOSOPHY</div>
            <h3 class="card-heading">Architecting for reliability, scale, and clarity.</h3>
            <p class="card-body">
                I treat software development as an exercise in structural precision. Rather than stitching hasty implementations together, I specialize in architecting decoupled systems — ensuring API interfaces remain independent, predictable, and resilient under production loads.
            </p>
            <div class="core-focus-list">
                <span class="focus-item">✦ Decoupled REST APIs</span>
                <span class="focus-item">✦ Cross-Platform Mobile (Flutter)</span>
                <span class="focus-item">✦ Relational Schemas (MySQL)</span>
            </div>
        </div>
    </section>

    <!-- 3. DOMAIN EXPERTISE & TECH STACK -->
    <section class="section-container">
        <div class="section-tag">02 // DOMAIN EXPERTISE</div>
        <h2 class="section-title">Technical Capabilities</h2>

        <div class="stack-grid">
            <div class="stack-column">
                <div class="stack-col-header">
                    <span class="col-icon">⚡</span>
                    <h3>Core Languages</h3>
                </div>
                <div class="skill-pills">
                    <span class="skill-tag">Dart</span>
                    <span class="skill-tag">PHP</span>
                    <span class="skill-tag">Python</span>
                    <span class="skill-tag">JavaScript (ES6+)</span>
                    <span class="skill-tag">TypeScript</span>
                    <span class="skill-tag">Kotlin</span>
                    <span class="skill-tag">C# / C++</span>
                    <span class="skill-tag">SQL</span>
                </div>
            </div>

            <div class="stack-column">
                <div class="stack-col-header">
                    <span class="col-icon">🛠️</span>
                    <h3>Frameworks & Systems</h3>
                </div>
                <div class="skill-pills">
                    <span class="skill-tag featured-tag">Flutter</span>
                    <span class="skill-tag featured-tag">Laravel REST</span>
                    <span class="skill-tag">Astro SSG</span>
                    <span class="skill-tag">MySQL</span>
                    <span class="skill-tag">Git / GitHub Actions</span>
                    <span class="skill-tag">Unity VR</span>
                    <span class="skill-tag">cPanel / WordPress</span>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. CHRONOLOGICAL MILESTONE LOG -->
    <section class="section-container">
        <div class="section-tag">03 // TRAJECTORY</div>
        <h2 class="section-title">Milestones & Technical Evolution</h2>

        <div class="milestone-log">
            <article class="milestone-entry">
                <div class="milestone-period">2026 – PRESENT</div>
                <div class="milestone-body">
                    <h3 class="milestone-role">Software Engineer Intern <span class="milestone-org">@ Apploqic Technologies</span></h3>
                    <p class="milestone-desc">
                        Engineering enterprise mobile applications (Client Quotation Estimator & Property Management) utilizing Flutter paired with decoupled Laravel REST API layers. Managing live production WordPress infrastructures, database optimizations, and client delivery pipelines.
                    </p>
                    <div class="tag-row">
                        <span class="mono-badge">Flutter</span>
                        <span class="mono-badge">Laravel API</span>
                        <span class="mono-badge">MySQL</span>
                        <span class="mono-badge">cPanel</span>
                    </div>
                </div>
            </article>

            <article class="milestone-entry">
                <div class="milestone-period">2022 – 2026</div>
                <div class="milestone-body">
                    <h3 class="milestone-role">Undergraduate Degree <span class="milestone-org">@ Universiti Malaysia Sabah</span></h3>
                    <p class="milestone-desc">
                        Underwent comprehensive software engineering training spanning system design patterns, algorithmic optimization, and data structures. Built ServeTogether as FYP and competed in the UM Hackathon AI track.
                    </p>
                    <div class="tag-row">
                        <span class="mono-badge">Distributed Systems</span>
                        <span class="mono-badge">Full-Stack Web</span>
                        <span class="mono-badge">Machine Learning</span>
                    </div>
                </div>
            </article>

            <article class="milestone-entry">
                <div class="milestone-period">2016 – 2020</div>
                <div class="milestone-body">
                    <h3 class="milestone-role">Foundational Studies <span class="milestone-org">@ Science Stream</span></h3>
                    <p class="milestone-desc">
                        Cultivated an early passion for computational thinking, advanced mathematics, and logic structures. This laid the quantitative framework for subsequent software architecture studies.
                    </p>
                </div>
            </article>
        </div>
    </section>

    <!-- 5. PERSONAL PURSUITS (BEYOND CODE) -->
    <section class="section-container">
        <div class="section-tag">04 // DIMENSIONS</div>
        <h2 class="section-title">Discipline & Pursuits Outside the Terminal</h2>

        <div class="pursuits-grid">
            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">🏃‍♂️</span>
                    <span class="pursuit-tag">ENDURANCE</span>
                </div>
                <h3 class="pursuit-title">Distance Running</h3>
                <p class="pursuit-desc">Structured long-distance training to build sustained physical stamina, mental endurance, and everyday discipline.</p>
            </div>

            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">🎮</span>
                    <span class="pursuit-tag">STRATEGY</span>
                </div>
                <h3 class="pursuit-title">Tactical Gaming</h3>
                <p class="pursuit-desc">Deep-dive RPG systems, emulation engineering, and complex decision-tree game theory.</p>
            </div>

            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">📊</span>
                    <span class="pursuit-tag">ANALYTICS</span>
                </div>
                <h3 class="pursuit-title">Personal Finance</h3>
                <p class="pursuit-desc">Quantitative asset valuation modeling, macro analysis, and custom-scripted portfolio tracking tools.</p>
            </div>

            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">⛩️</span>
                    <span class="pursuit-tag">CULTURE</span>
                </div>
                <h3 class="pursuit-title">Japanese Language</h3>
                <p class="pursuit-desc">Consistently studying Kanji and grammar structures to broaden cross-cultural communication fluency.</p>
            </div>
        </div>
    </section>

    <!-- 6. GUIDING AXIOMS -->
    <section class="section-container" style="margin-bottom: 6rem;">
        <div class="section-tag">05 // PRINCIPLES</div>
        <h2 class="section-title">Guiding Axioms</h2>

        <div class="axioms-grid">
            <div class="axiom-box">
                <p class="axiom-quote">"Yesterday is history, tomorrow is a mystery, but today is a gift. That is why it is called the present."</p>
                <span class="axiom-meta">— Master Oogway</span>
            </div>
            <div class="axiom-box">
                <p class="axiom-quote">"If you only do what you can do, you will never be more than who you are."</p>
                <span class="axiom-meta">— Master Shifu</span>
            </div>
        </div>
    </section>

</Layout>

<style>
    /* Split Hero */
    .hero-split {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 3rem;
        align-items: center;
        padding: 5rem 0 4rem;
    }

    @media (max-width: 860px) {
        .hero-split {
            grid-template-columns: 1fr;
            gap: 2rem;
            padding: 3rem 0;
        }
    }

    .hero-headline {
        font-size: 2.75rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.18;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }

    .gradient-text {
        background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-bio {
        color: #94a3b8;
        font-size: 1.05rem;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .hero-bio strong {
        color: #f1f5f9;
    }

    .cta-row {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.6rem;
        border-radius: 6px;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-emerald {
        background-color: #10b981;
        color: #022c22;
    }

    .btn-emerald:hover {
        background-color: #34d399;
        transform: translateY(-2px);
        box-shadow: 0 4px 18px rgba(16, 185, 129, 0.3);
    }

    .btn-ghost {
        background-color: #0f172a;
        color: #cbd5e1;
        border: 1px solid #1e293b;
    }

    .btn-ghost:hover {
        border-color: #10b981;
        color: #ffffff;
    }

    /* Console Card */
    .console-box {
        background-color: #090d16;
        border: 1px solid #1e293b;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .console-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: #0f172a;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid #1e293b;
    }

    .window-controls {
        display: flex;
        gap: 6px;
    }

    .win-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .close { background-color: #ef4444; }
    .minimize { background-color: #f59e0b; }
    .maximize { background-color: #10b981; }

    .console-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #64748b;
    }

    .console-content {
        padding: 1.25rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.84rem;
        color: #cbd5e1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .prompt {
        color: #10b981;
        font-weight: bold;
    }

    .console-res {
        color: #94a3b8;
        padding-left: 0.85rem;
        border-left: 2px solid #1e293b;
        margin-bottom: 0.4rem;
    }

    .text-emerald {
        color: #34d399 !important;
    }

    /* Section Layout */
    .section-container {
        margin-bottom: 5rem;
    }

    .section-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #10b981;
        letter-spacing: 0.1em;
        margin-bottom: 0.5rem;
    }

    .section-title {
        font-size: 1.9rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 2rem;
        letter-spacing: -0.02em;
    }

    /* Philosophy Card */
    .philosophy-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2.25rem;
        display: flex;
        flex-direction: column;
    }

    .card-kicker {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #10b981;
        letter-spacing: 0.08em;
        margin-bottom: 1rem;
    }

    .card-heading {
        color: #ffffff;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.4;
        margin-bottom: 1rem;
    }

    .card-body {
        color: #94a3b8;
        font-size: 0.96rem;
        line-height: 1.7;
        margin-bottom: 1.75rem;
    }

    .core-focus-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .focus-item {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #cbd5e1;
        background-color: #162032;
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        border: 1px solid #223249;
    }

    /* Domain / Stack Grid */
    .stack-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .stack-column {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 1.75rem;
    }

    .stack-col-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #1e293b;
    }

    .stack-col-header h3 {
        font-size: 1.1rem;
        color: #ffffff;
    }

    .skill-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .skill-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        background-color: #162032;
        color: #cbd5e1;
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        border: 1px solid #223249;
    }

    .featured-tag {
        border-color: rgba(16, 185, 129, 0.4);
        color: #34d399;
    }

    /* Milestone Log */
    .milestone-log {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .milestone-entry {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 1.75rem 2rem;
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 2rem;
        transition: border-color 0.2s ease;
    }

    .milestone-entry:hover {
        border-color: #10b981;
    }

    @media (max-width: 768px) {
        .milestone-entry {
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }
    }

    .milestone-period {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: #10b981;
        font-weight: 600;
    }

    .milestone-role {
        color: #ffffff;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .milestone-org {
        color: #94a3b8;
        font-weight: 400;
    }

    .milestone-desc {
        color: #94a3b8;
        font-size: 0.92rem;
        line-height: 1.7;
        margin-bottom: 1rem;
    }

    .tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .mono-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        background-color: #162032;
        color: #94a3b8;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
    }

    /* Pursuits Grid */
    .pursuits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.25rem;
    }

    .pursuit-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .pursuit-card:hover {
        transform: translateY(-2px);
        border-color: #10b981;
    }

    .pursuit-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .pursuit-icon {
        font-size: 1.5rem;
    }

    .pursuit-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: #10b981;
        background-color: rgba(16, 185, 129, 0.1);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        letter-spacing: 0.05em;
    }

    .pursuit-title {
        color: #ffffff;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .pursuit-desc {
        color: #94a3b8;
        font-size: 0.88rem;
        line-height: 1.6;
    }

    /* Axioms (2-Card Grid) */
    .axioms-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .axiom-box {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-left: 3px solid #10b981;
        border-radius: 6px;
        padding: 1.75rem 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.25rem;
    }

    .axiom-quote {
        color: #e2e8f0;
        font-size: 1.05rem;
        font-style: italic;
        line-height: 1.7;
    }

    .axiom-meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.82rem;
        color: #10b981;
        font-weight: 600;
    }
</style>
