---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Teo Jun Cheng">
    <header class="page-header">
        <div class="terminal-prompt">cat about_me.md</div>
        <h1>The Developer Behind the Code</h1>
    </header>

    <section style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 4rem;">
        <div style="color: var(--text-secondary); font-size: 1.05rem;">
            <p style="margin-bottom: 1.25rem;">
                Hello! I'm <strong>Teo Jun Cheng</strong>, a final-year Software Engineering student at <strong>Universiti Malaysia Sabah (UMS)</strong>[cite: 1]. My journey in tech is driven by curiosity, systematic thinking, and building software that solves real functional problems[cite: 1].
            </p>
            <div style="background-color: var(--bg-card); border-left: 4px solid var(--accent-green); padding: 1.25rem; margin: 1.5rem 0; border-radius: 8px;">
                <p style="margin:0; color:#fff; font-weight:500;">
                    💡 "Building clean, scalable, decoupled applications with modern web and mobile frameworks."[cite: 1]
                </p>
            </div>
            <p style="margin-bottom: 1.25rem;">
                Whether it's designing decoupled REST APIs with Laravel[cite: 1], crafting mobile applications with Flutter[cite: 1], or experimenting with VR simulations in Unity[cite: 1], I enjoy turning complex ideas into polished systems[cite: 1].
            </p>
            <p>
                Currently, I'm completing my industrial internship at <strong>Apploqic Technologies</strong> in Kuala Lumpur[cite: 1], preparing for full-time opportunities starting September 2026[cite: 1].
            </p>
        </div>

        <div>
            <div class="card" style="position: sticky; top: 90px;">
                <h3 style="color:#fff; margin-bottom:1rem; font-size:1.1rem;">Quick Facts</h3>
                <ul style="list-style:none; color:var(--text-secondary); font-size:0.9rem; line-height:2;">
                    <li>📍 <strong>Location:</strong> Kuala Lumpur / Sabah[cite: 1]</li>
                    <li>🎓 <strong>Degree:</strong> BCompSc (Software Engineering)[cite: 1]</li>
                    <li>🏆 <strong>Academic:</strong> 3.74 CGPA (6x Dean's List)[cite: 1]</li>
                    <li>🌐 <strong>Languages:</strong> English, Malay, Mandarin[cite: 1]</li>
                    <li>💼 <strong>Availability:</strong> Full-time (Sept 2026)[cite: 1]</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Interests -->
    <section style="margin-bottom: 4rem;">
        <div class="terminal-prompt">// BEYOND THE TERMINAL</div>
        <h2>Interests & Pursuits</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem;">
            <div class="card">
                <h3 style="color:#fff; font-size:1.05rem; margin-bottom:0.5rem;">🏃‍♂️ Running & Fitness</h3>
                <p style="color:var(--text-secondary); font-size:0.88rem;">Dedicated runner focusing on building endurance and cardiovascular stamina through structured training.</p>
            </div>
            <div class="card">
                <h3 style="color:#fff; font-size:1.05rem; margin-bottom:0.5rem;">🎮 Gaming & Emulation</h3>
                <p style="color:var(--text-secondary); font-size:0.88rem;">Enthusiast of deep RPG titles, retro console emulation, and strategy games.</p>
            </div>
            <div class="card">
                <h3 style="color:#fff; font-size:1.05rem; margin-bottom:0.5rem;">📊 Personal Finance</h3>
                <p style="color:var(--text-secondary); font-size:0.88rem;">Interested in quantitative asset valuation, automated tracking tools, and financial models.</p>
            </div>
            <div class="card">
                <h3 style="color:#fff; font-size:1.05rem; margin-bottom:0.5rem;">⛩️ Language Study</h3>
                <p style="color:var(--text-secondary); font-size:0.88rem;">Actively studying Japanese language fundamentals alongside professional engineering goals.</p>
            </div>
        </div>
    </section>
</Layout>