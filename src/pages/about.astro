---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Teo Jun Cheng">

    <!-- 1. HEADER SECTION -->
    <header class="about-hero">
        <div class="terminal-tag">// ABOUT ME</div>
        <h1 class="page-title">The person behind <span class="highlight">the code</span></h1>
        <p class="hero-intro">
            I'm Teo Jun Cheng — a final year Software Engineering student at Universiti Malaysia Sabah. I build things with purpose, stay curious, and craft software solutions that deliver lasting value.
        </p>
    </header>

    <div class="divider"></div>

    <!-- 2. WHO I AM -->
    <section class="content-section">
        <div class="terminal-tag">// WHO I AM</div>
        <h2 class="section-heading">A bit about me</h2>

        <div class="bio-grid">
            <div class="bio-col">
                <p>
                    I'm currently completing my Bachelor of Computer Science in Software Engineering at <strong>Universiti Malaysia Sabah (UMS)</strong>, while undergoing my industrial internship at <strong>Apploqic Technologies</strong> in Kuala Lumpur.
                </p>
                <p>
                    I approach engineering systematically and independently — analyzing architectures a few steps ahead to build maintainable, decoupled systems. I care deeply about product reliability and user experience, treating every build with craftsmanship.
                </p>
            </div>

            <div class="bio-col">
                <p>
                    Outside of core development, I focus on running, gaming, language study, and personal finance. I believe technology should empower people and streamline everyday processes without adding unnecessary complexity.
                </p>
                <p>
                    I'm driven by continuous growth — in technical capabilities, professional discipline, and the tangible impact of the products I deliver. That's what keeps me motivated every day.
                </p>
            </div>
        </div>
    </section>

    <!-- 3. MY JOURNEY / TIMELINE -->
    <section class="content-section">
        <div class="terminal-tag">// MY JOURNEY</div>
        <h2 class="section-heading">My Story</h2>

        <div class="timeline-container">
            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-date">2016 – 2020</div>
                <h3 class="timeline-title">Secondary Education & Science Stream</h3>
                <p class="timeline-desc">
                    Built strong foundations in mathematics and logical problem-solving. This period sparked my curiosity in computer systems and set the direction for my software development career.
                </p>
            </div>

            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-date">2022 – PRESENT</div>
                <h3 class="timeline-title">Universiti Malaysia Sabah (UMS)</h3>
                <p class="timeline-desc">
                    Pursuing BCompSc (Hons) Software Engineering. Maintained a <strong>3.74 CGPA</strong> with <strong>6× Dean's List Awards</strong>. Developed key projects including ServeTogether (FYP) and an AI Recommendation Prototype during the UM Hackathon.
                </p>
            </div>

            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-date">2026 – PRESENT</div>
                <h3 class="timeline-title">Software Engineer Intern • Apploqic Technologies</h3>
                <p class="timeline-desc">
                    Engineering cross-platform mobile applications (Flutter) integrated with decoupled Laravel REST API backends. Managing live server deployments, WordPress environments, and client deliverables.
                </p>
            </div>
        </div>
    </section>

    <!-- 4. WHAT I DO FOR FUN -->
    <section class="content-section">
        <div class="terminal-tag">// BEYOND THE SCREEN</div>
        <h2 class="section-heading">What I do for fun</h2>

        <div class="fun-grid">
            <div class="fun-card">
                <div class="fun-icon">🏃‍♂️</div>
                <h3 class="fun-title">Running</h3>
                <p class="fun-desc">Dedicated to endurance training and long-distance running. A great way to stay sharp, disciplined, and energized.</p>
            </div>

            <div class="fun-card">
                <div class="fun-icon">🎮</div>
                <h3 class="fun-title">Gaming</h3>
                <p class="fun-desc">A way to unwind and sharpen strategic thinking. I enjoy deep RPG narratives, tactical strategy, and classic emulation.</p>
            </div>

            <div class="fun-card">
                <div class="fun-icon">📊</div>
                <h3 class="fun-title">Finance</h3>
                <p class="fun-desc">Passionate about quantitative asset valuation, automated expense tracking, and understanding global macroeconomic trends.</p>
            </div>

            <div class="fun-card">
                <div class="fun-icon">⛩️</div>
                <h3 class="fun-title">Languages</h3>
                <p class="fun-desc">Actively studying Japanese language grammar and Kanji to expand cultural horizons and communication skills.</p>
            </div>

            <div class="fun-card">
                <div class="fun-icon">🍳</div>
                <h3 class="fun-title">Cooking</h3>
                <p class="fun-desc">Experimenting with balanced meals and recipe optimization. Cooking is a creative outlet and a great break from screens.</p>
            </div>

            <div class="fun-card">
                <div class="fun-icon">🤝</div>
                <h3 class="fun-title">Community</h3>
                <p class="fun-desc">Engaging with tech communities, hackathons, and collaborative open-source knowledge sharing.</p>
            </div>
        </div>
    </section>

    <!-- 5. WORDS THAT GUIDE ME -->
    <section class="content-section" style="margin-bottom: 5rem;">
        <div class="terminal-tag">// QUOTES I LIVE BY</div>
        <h2 class="section-heading">Words that <span class="highlight">guide me</span></h2>

        <div class="quotes-stack">
            <div class="quote-card">
                <p class="quote-text">"Life is like riding a bicycle. To keep your balance, you must keep moving."</p>
                <div class="quote-author">— Albert Einstein</div>
            </div>

            <div class="quote-card">
                <p class="quote-text">"The time you become truly a failure is when you stop trying to succeed in life."</p>
                <div class="quote-author">— Personal Maxim</div>
            </div>

            <div class="quote-card">
                <p class="quote-text">"Take advantage of five before five: your youth before your old age, your health before your sickness, your wealth before your poverty, your free time before you are preoccupied, and your life before your death."</p>
                <div class="quote-author">— Timeless Proverb</div>
            </div>
        </div>
    </section>

</Layout>

<style>
    .about-hero {
        padding: 5rem 0 2rem;
        max-width: 820px;
    }

    .terminal-tag {
        font-family: 'JetBrains Mono', monospace;
        color: #38bdf8;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        letter-spacing: 0.05em;
    }

    .page-title {
        font-size: 3.25rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.15;
        margin-bottom: 1.25rem;
        letter-spacing: -0.03em;
    }

    .highlight {
        color: #38bdf8;
    }

    .hero-intro {
        color: #94a3b8;
        font-size: 1.15rem;
        line-height: 1.7;
    }

    .divider {
        height: 1px;
        background-color: #1e293b;
        margin: 2rem 0 3.5rem;
    }

    .content-section {
        margin-bottom: 4.5rem;
    }

    .section-heading {
        font-size: 2rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 2rem;
        letter-spacing: -0.02em;
    }

    /* 2-Column Bio */
    .bio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2.5rem;
    }

    .bio-col p {
        color: #94a3b8;
        font-size: 1.05rem;
        line-height: 1.8;
        margin-bottom: 1.5rem;
    }

    .bio-col strong {
        color: #f8fafc;
    }

    /* Timeline */
    .timeline-container {
        position: relative;
        padding-left: 2rem;
        border-left: 2px solid #1e293b;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        margin-left: 0.5rem;
    }

    .timeline-item {
        position: relative;
    }

    .timeline-dot {
        position: absolute;
        left: -2.45rem;
        top: 0.25rem;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background-color: #060913;
        border: 2px solid #38bdf8;
    }

    .timeline-date {
        font-family: 'JetBrains Mono', monospace;
        color: #38bdf8;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.4rem;
    }

    .timeline-title {
        color: #ffffff;
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .timeline-desc {
        color: #94a3b8;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    /* 6-Card Grid */
    .fun-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .fun-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .fun-card:hover {
        border-color: #38bdf8;
        transform: translateY(-2px);
    }

    .fun-icon {
        font-size: 2.25rem;
        margin-bottom: 1rem;
    }

    .fun-title {
        color: #ffffff;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .fun-desc {
        color: #94a3b8;
        font-size: 0.9rem;
        line-height: 1.6;
    }

    /* Quotes Stack */
    .quotes-stack {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .quote-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 2rem 2.25rem;
        transition: border-color 0.2s ease;
    }

    .quote-card:hover {
        border-color: #38bdf8;
    }

    .quote-text {
        color: #e2e8f0;
        font-size: 1.1rem;
        font-style: italic;
        line-height: 1.7;
        margin-bottom: 1rem;
    }

    .quote-author {
        font-family: 'JetBrains Mono', monospace;
        color: #38bdf8;
        font-size: 0.9rem;
        font-weight: 600;
    }
</style>
