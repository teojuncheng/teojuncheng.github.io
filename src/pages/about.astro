---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Teo Jun Cheng">

    <!-- 1. EDITORIAL DOSSIER HEADER -->
    <header class="dossier-hero">
        <div class="section-tag">01 // DOSSIER</div>
        <h1 class="dossier-title">Software Engineer, Systematic Thinker & <span class="gradient-text">Problem Solver</span>.</h1>
        <p class="dossier-lead">
            Final-year Software Engineering undergraduate at Universiti Malaysia Sabah (UMS), actively operating at the intersection of decoupled backend architectures and responsive client applications.
        </p>
    </header>

    <!-- 2. BENTO OVERVIEW GRID -->
    <section class="section-block">
        <div class="bento-grid">
            
            <!-- Large Card: Core Philosophy -->
            <div class="bento-card bento-wide">
                <div class="card-kicker">ENGINEERING PHILOSOPHY</div>
                <h2 class="card-heading">Architecting for reliability, scale, and clarity.</h2>
                <p class="card-body">
                    I treat software development as an exercise in structural precision. Rather than stitching hasty implementations together, I specialize in architecting decoupled systems — ensuring API interfaces remain independent, predictable, and resilient under production loads.
                </p>
                <div class="core-focus-list">
                    <span class="focus-item">✦ Decoupled REST APIs</span>
                    <span class="focus-item">✦ Cross-Platform Mobile (Flutter)</span>
                    <span class="focus-item">✦ Relational Schemas (MySQL)</span>
                </div>
            </div>

            <!-- Side Card: Fast Diagnostics -->
            <div class="bento-card">
                <div class="card-kicker">CORE SPECIFICATIONS</div>
                <ul class="spec-list">
                    <li>
                        <span class="spec-key">INSTITUTION</span>
                        <span class="spec-val">Universiti Malaysia Sabah</span>
                    </li>
                    <li>
                        <span class="spec-key">MAJOR</span>
                        <span class="spec-val">BCompSc. Software Engineering</span>
                    </li>
                    <li>
                        <span class="spec-key">ACADEMIC STANDING</span>
                        <span class="spec-val text-emerald">3.74 CGPA (6× Dean's List)</span>
                    </li>
                    <li>
                        <span class="spec-key">INTERNSHIP</span>
                        <span class="spec-val">Apploqic Technologies</span>
                    </li>
                    <li>
                        <span class="spec-key">AVAILABILITY</span>
                        <span class="spec-val text-emerald">September 2026 (Full-Time)</span>
                    </li>
                </ul>
            </div>

        </div>
    </section>

    <!-- 3. CHRONOLOGICAL MILESTONE LOG -->
    <section class="section-block">
        <div class="section-tag">02 // TRAJECTORY</div>
        <h2 class="section-title">Milestones & Technical Evolution</h2>

        <div class="milestone-log">
            
            <article class="milestone-entry">
                <div class="milestone-period">2026 – PRESENT</div>
                <div class="milestone-body">
                    <h3 class="milestone-role">Software Engineer Intern <span class="milestone-org">@ Apploqic Technologies</span></h3>
                    <p class="milestone-desc">
                        Engineering enterprise mobile applications (Client Quotation Estimator & Property Management) utilizing Flutter paired with decoupled Laravel REST API layers. Managing live production WordPress infrastructures, database optimizations, and client delivery pipelines.
                    </p>
                    <div class="tag-row">
                        <span class="mono-badge">Flutter</span>
                        <span class="mono-badge">Laravel API</span>
                        <span class="mono-badge">MySQL</span>
                        <span class="mono-badge">cPanel</span>
                    </div>
                </div>
            </article>

            <article class="milestone-entry">
                <div class="milestone-period">2022 – 2026</div>
                <div class="milestone-body">
                    <h3 class="milestone-role">Undergraduate Degree <span class="milestone-org">@ Universiti Malaysia Sabah</span></h3>
                    <p class="milestone-desc">
                        Underwent comprehensive software engineering training spanning system design patterns, algorithmic optimization, and data structures. Maintained a 3.74 CGPA with 6 consecutive Dean's List honors. Built ServeTogether as FYP and competed in the UM Hackathon AI track.
                    </p>
                    <div class="tag-row">
                        <span class="mono-badge">Distributed Systems</span>
                        <span class="mono-badge">Full-Stack Web</span>
                        <span class="mono-badge">Machine Learning</span>
                    </div>
                </div>
            </article>

            <article class="milestone-entry">
                <div class="milestone-period">2016 – 2020</div>
                <div class="milestone-body">
                    <h3 class="milestone-role">Foundational Studies <span class="milestone-org">@ Science Stream</span></h3>
                    <p class="milestone-desc">
                        Cultivated an early passion for computational thinking, advanced mathematics, and logic structures. This laid the quantitative framework for subsequent software architecture studies.
                    </p>
                </div>
            </article>

        </div>
    </section>

    <!-- 4. PERSONAL PURSUITS (BEYOND CODE) -->
    <section class="section-block">
        <div class="section-tag">03 // DIMENSIONS</div>
        <h2 class="section-title">Discipline & Pursuits Outside the Terminal</h2>

        <div class="pursuits-grid">
            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">🏃‍♂️</span>
                    <span class="pursuit-tag">ENDURANCE</span>
                </div>
                <h3 class="pursuit-title">Distance Running</h3>
                <p class="pursuit-desc">Structured long-distance training to build sustained physical stamina, mental endurance, and everyday discipline.</p>
            </div>

            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">🎮</span>
                    <span class="pursuit-tag">STRATEGY</span>
                </div>
                <h3 class="pursuit-title">Tactical Gaming</h3>
                <p class="pursuit-desc">Deep-dive RPG systems, emulation engineering, and complex decision-tree game theory.</p>
            </div>

            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">📊</span>
                    <span class="pursuit-tag">ANALYTICS</span>
                </div>
                <h3 class="pursuit-title">Personal Finance</h3>
                <p class="pursuit-desc">Quantitative asset valuation modeling, macro analysis, and custom-scripted portfolio tracking tools.</p>
            </div>

            <div class="pursuit-card">
                <div class="pursuit-top">
                    <span class="pursuit-icon">⛩️</span>
                    <span class="pursuit-tag">CULTURE</span>
                </div>
                <h3 class="pursuit-title">Japanese Language</h3>
                <p class="pursuit-desc">Consistently studying Kanji and grammar structures to broaden cross-cultural communication fluency.</p>
            </div>
        </div>
    </section>

    <!-- 5. GUIDING AXIOMS -->
    <section class="section-block" style="margin-bottom: 6rem;">
        <div class="section-tag">04 // PRINCIPLES</div>
        <h2 class="section-title">Guiding Axioms</h2>

        <div class="axioms-grid">
            <div class="axiom-box">
                <p class="axiom-quote">"Yesterday is history, tomorrow is a mystery, but today is a gift. That is why it is called the present."</p>
                <span class="axiom-meta">— Master Oogway</span>
            </div>
            <div class="axiom-box">
                <p class="axiom-quote">"If you only do what you can do, you will never be more than who you are."</p>
                <span class="axiom-meta">— Master Shifu</span>
            </div>
        </div>
    </section>

</Layout>

<style>
    /* Dossier Hero */
    .dossier-hero {
        padding: 5rem 0 3rem;
        max-width: 860px;
    }

    .section-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #10b981;
        letter-spacing: 0.1em;
        margin-bottom: 0.75rem;
    }

    .dossier-title {
        font-size: 2.85rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.2;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }

    .gradient-text {
        background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .dossier-lead {
        color: #94a3b8;
        font-size: 1.15rem;
        line-height: 1.7;
    }

    /* Block Structure */
    .section-block {
        margin-bottom: 5.5rem;
    }

    .section-title {
        font-size: 1.85rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.02em;
        margin-bottom: 2rem;
    }

    /* Bento Grid */
    .bento-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 1.5rem;
    }

    @media (max-width: 860px) {
        .bento-grid {
            grid-template-columns: 1fr;
        }
    }

    .bento-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .card-kicker {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #10b981;
        letter-spacing: 0.08em;
        margin-bottom: 1rem;
    }

    .card-heading {
        color: #ffffff;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.4;
        margin-bottom: 1rem;
    }

    .card-body {
        color: #94a3b8;
        font-size: 0.96rem;
        line-height: 1.7;
        margin-bottom: 1.75rem;
    }

    .core-focus-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .focus-item {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #cbd5e1;
        background-color: #162032;
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        border: 1px solid #223249;
    }

    /* Spec List */
    .spec-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: auto;
    }

    .spec-list li {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        border-bottom: 1px solid #162032;
        padding-bottom: 0.75rem;
    }

    .spec-list li:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .spec-key {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: #64748b;
        letter-spacing: 0.05em;
    }

    .spec-val {
        color: #f1f5f9;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .text-emerald {
        color: #34d399 !important;
    }

    /* Milestone Log */
    .milestone-log {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .milestone-entry {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 1.75rem 2rem;
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 2rem;
        transition: border-color 0.2s ease;
    }

    .milestone-entry:hover {
        border-color: #10b981;
    }

    @media (max-width: 768px) {
        .milestone-entry {
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }
    }

    .milestone-period {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: #10b981;
        font-weight: 600;
    }

    .milestone-role {
        color: #ffffff;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .milestone-org {
        color: #94a3b8;
        font-weight: 400;
    }

    .milestone-desc {
        color: #94a3b8;
        font-size: 0.92rem;
        line-height: 1.7;
        margin-bottom: 1rem;
    }

    .tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .mono-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        background-color: #162032;
        color: #94a3b8;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
    }

    /* Pursuits Grid */
    .pursuits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.25rem;
    }

    .pursuit-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .pursuit-card:hover {
        transform: translateY(-2px);
        border-color: #10b981;
    }

    .pursuit-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .pursuit-icon {
        font-size: 1.5rem;
    }

    .pursuit-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: #10b981;
        background-color: rgba(16, 185, 129, 0.1);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        letter-spacing: 0.05em;
    }

    .pursuit-title {
        color: #ffffff;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .pursuit-desc {
        color: #94a3b8;
        font-size: 0.88rem;
        line-height: 1.6;
    }

    /* Axioms (2-Card Grid) */
    .axioms-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .axiom-box {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-left: 3px solid #10b981;
        border-radius: 6px;
        padding: 1.75rem 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.25rem;
    }

    .axiom-quote {
        color: #e2e8f0;
        font-size: 1.05rem;
        font-style: italic;
        line-height: 1.7;
    }

    .axiom-meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.82rem;
        color: #10b981;
        font-weight: 600;
    }
</style>
