---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects | Teo Jun Cheng">
    <header class="page-header">
        <div class="terminal-prompt">ls -la ./featured_projects/</div>
        <h1>Software Builds & Projects</h1>
        <p style="color: var(--text-secondary); max-width: 650px; margin-top: 0.5rem;">
            Full-stack web architectures, mobile cross-platform builds, machine learning tools, and VR simulations[cite: 1].
        </p>
    </header>

    <section style="display: flex; flex-direction: column; gap: 2rem; margin-bottom: 4rem;">
        
        <!-- Project 1: ServeTogether -->
        <div class="card">
            <div style="display: flex; justify-content: space-between; flex-wrap: wrap; margin-bottom: 0.75rem;">
                <h3 style="color:#fff; font-size: 1.35rem;">ServeTogether — Personalised Volunteer System[cite: 1]</h3>
                <span style="font-family: monospace; font-size: 0.8rem; background: rgba(168, 85, 247, 0.15); color: var(--accent-purple); padding: 0.2rem 0.6rem; border-radius: 20px;">Final Year Project[cite: 1]</span>
            </div>
            <p style="color: var(--text-secondary); margin-bottom: 1.25rem;">
                A comprehensive web-based volunteer management platform with an interest-based recommendation engine for opportunity matching[cite: 1].
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">PHP</span>
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">MySQL</span>
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">JavaScript</span>
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">HTML5/CSS3</span>
            </div>
        </div>

        <!-- Project 2: Quotation App -->
        <div class="card">
            <div style="display: flex; justify-content: space-between; flex-wrap: wrap; margin-bottom: 0.75rem;">
                <h3 style="color:#fff; font-size: 1.35rem;">Client Quotation & Service Request App</h3>
                <span style="font-family: monospace; font-size: 0.8rem; background: rgba(6, 182, 212, 0.15); color: var(--accent-cyan); padding: 0.2rem 0.6rem; border-radius: 20px;">Apploqic Technologies[cite: 1]</span>
            </div>
            <p style="color: var(--text-secondary); margin-bottom: 1.25rem;">
                A decoupled cross-platform mobile application letting clients customize service parameters and submit instant price quotation requests[cite: 1].
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">Flutter</span>
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">Dart</span>
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">Laravel API</span>
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">MySQL</span>
            </div>
        </div>

        <!-- Project 3: Property App -->
        <div class="card">
            <div style="display: flex; justify-content: space-between; flex-wrap: wrap; margin-bottom: 0.75rem;">
                <h3 style="color:#fff; font-size: 1.35rem;">Property Management Application</h3>
                <span style="font-family: monospace; font-size: 0.8rem; background: rgba(6, 182, 212, 0.15); color: var(--accent-cyan); padding: 0.2rem 0.6rem; border-radius: 20px;">Apploqic Technologies[cite: 1]</span>
            </div>
            <p style="color: var(--text-secondary); margin-bottom: 1.25rem;">
                Cross-platform mobile solution for managing property units, maintenance tracking, and real-time backend synchronization[cite: 1].
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">Flutter</span>
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">Laravel API</span>
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">cPanel</span>
            </div>
        </div>

        <!-- Project 4: AI Chatbot -->
        <div class="card">
            <div style="display: flex; justify-content: space-between; flex-wrap: wrap; margin-bottom: 0.75rem;">
                <h3 style="color:#fff; font-size: 1.35rem;">AI Sales Recommendation Chatbot[cite: 1]</h3>
                <span style="font-family: monospace; font-size: 0.8rem; background: rgba(16, 185, 129, 0.15); color: var(--accent-green); padding: 0.2rem 0.6rem; border-radius: 20px;">UM Hackathon[cite: 1]</span>
            </div>
            <p style="color: var(--text-secondary); margin-bottom: 1.25rem;">
                AI chatbot prototype analyzing Grab customer behavioral datasets to provide targeted, high-value product suggestions[cite: 1].
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">Python</span>
                <span style="font-family: monospace; font-size: 0.8rem; background: var(--bg-main); padding: 0.3rem 0.75rem; border-radius: 6px; border: 1px solid var(--border-card);">Machine Learning</span>
            </div>
        </div>

    </section>
</Layout>