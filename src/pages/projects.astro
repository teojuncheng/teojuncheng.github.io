---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects | Teo Jun Cheng">

    <!-- 1. HEADER SECTION -->
    <header class="projects-hero">
        <div class="terminal-tag">// WHAT I'VE BUILT</div>
        <h1 class="page-title">Projects & <span class="highlight">Skills</span></h1>
        <p class="hero-intro">
            A collection of things I've built — from final year projects and enterprise mobile solutions to hackathon prototypes. Each one taught me something new.
        </p>
    </header>

    <div class="divider"></div>

    <!-- 2. WHAT I'VE BUILT (PROJECTS) -->
    <section class="content-section">
        <div class="terminal-tag">// PROJECTS</div>
        <h2 class="section-heading">What I've Built</h2>

        <div class="projects-grid">
            
            <!-- Project 1: ServeTogether (FYP) -->
            <div class="project-card">
                <div class="card-badges">
                    <span class="badge badge-blue">Final Year Project</span>
                    <span class="badge badge-green">✓ Completed</span>
                    <span class="badge badge-muted">🔒 Private Repo</span>
                </div>
                <h3 class="project-title">ServeTogether — Personalised Volunteer System</h3>
                <p class="project-desc">
                    A web-based volunteer management system designed to digitize outreach, streamline participant coordination, and deliver automated interest-based opportunity matching.
                </p>
                <div class="tech-tags">
                    <span class="tag">PHP</span>
                    <span class="tag">MySQL</span>
                    <span class="tag">JavaScript</span>
                    <span class="tag">HTML5 / CSS3</span>
                    <span class="tag">Git</span>
                </div>
            </div>

            <!-- Project 2: Quotation App (Apploqic) -->
            <div class="project-card">
                <div class="card-badges">
                    <span class="badge badge-cyan">Apploqic Technologies</span>
                    <span class="badge badge-green">✓ Completed</span>
                    <span class="badge badge-muted">🔒 Client App</span>
                </div>
                <h3 class="project-title">Client Quotation & Service Request App</h3>
                <p class="project-desc">
                    Decoupled cross-platform mobile application enabling enterprise clients to customize parameters, view live calculation estimates, and submit formal price quotation inquiries directly to backend servers.
                </p>
                <div class="tech-tags">
                    <span class="tag tag-highlight">Flutter</span>
                    <span class="tag">Dart</span>
                    <span class="tag tag-highlight">Laravel REST API</span>
                    <span class="tag">MySQL</span>
                </div>
            </div>

            <!-- Project 3: Property App (Apploqic) -->
            <div class="project-card">
                <div class="card-badges">
                    <span class="badge badge-cyan">Apploqic Technologies</span>
                    <span class="badge badge-green">✓ Active</span>
                    <span class="badge badge-muted">🔒 Client App</span>
                </div>
                <h3 class="project-title">Property Management Application</h3>
                <p class="project-desc">
                    Full-featured mobile solution built to manage property unit portfolios, automate tenant request logs, and synchronize backend records across distributed databases.
                </p>
                <div class="tech-tags">
                    <span class="tag tag-highlight">Flutter</span>
                    <span class="tag">Dart</span>
                    <span class="tag tag-highlight">Laravel REST API</span>
                    <span class="tag">cPanel</span>
                </div>
            </div>

            <!-- Project 4: AI Chatbot (Hackathon) -->
            <div class="project-card">
                <div class="card-badges">
                    <span class="badge badge-purple">UM Hackathon</span>
                    <span class="badge badge-green">✓ Prototype</span>
                    <a href="https://github.com/teojuncheng" target="_blank" class="badge badge-link">🔗 View Repo →</a>
                </div>
                <h3 class="project-title">AI Sales Recommendation Chatbot</h3>
                <p class="project-desc">
                    Machine learning recommendation prototype leveraging customer transaction datasets to dynamically predict consumer intent and suggest tailored upsell items.
                </p>
                <div class="tech-tags">
                    <span class="tag">Python</span>
                    <span class="tag">Machine Learning</span>
                    <span class="tag">Pandas</span>
                    <span class="tag">Data Analytics</span>
                </div>
            </div>

        </div>
    </section>

    <!-- 3. OPEN SOURCE & GITHUB ACTIVITY -->
    <section class="content-section" style="margin-bottom: 5rem;">
        <div class="terminal-tag">// OPEN SOURCE</div>
        <h2 class="section-heading">GitHub Activity</h2>

        <!-- Metric Stat Cards -->
        <div class="github-stats-grid">
            <div class="github-stat-card">
                <div class="stat-number">10+</div>
                <div class="stat-label">Public Repos</div>
            </div>
            <div class="github-stat-card">
                <div class="stat-number">200+</div>
                <div class="stat-label">Commits This Year</div>
            </div>
            <div class="github-stat-card">
                <div class="stat-number">300+</div>
                <div class="stat-label">Total Contributions</div>
            </div>
            <div class="github-stat-card">
                <div class="stat-number">2022</div>
                <div class="stat-label">Active Since</div>
            </div>
        </div>

        <!-- Top Languages Card -->
        <div class="lang-bar-card">
            <div class="lang-header">TOP LANGUAGES</div>
            <div class="lang-bar">
                <div class="bar-segment bar-flutter" style="width: 35%;"></div>
                <div class="bar-segment bar-php" style="width: 25%;"></div>
                <div class="bar-segment bar-astro" style="width: 20%;"></div>
                <div class="bar-segment bar-python" style="width: 12%;"></div>
                <div class="bar-segment bar-js" style="width: 8%;"></div>
            </div>
            <div class="lang-legend">
                <span class="legend-item"><span class="dot dot-flutter"></span> Dart / Flutter 35%</span>
                <span class="legend-item"><span class="dot dot-php"></span> PHP / Laravel 25%</span>
                <span class="legend-item"><span class="dot dot-astro"></span> Astro 20%</span>
                <span class="legend-item"><span class="dot dot-python"></span> Python 12%</span>
                <span class="legend-item"><span class="dot dot-js"></span> JavaScript 8%</span>
            </div>
        </div>

        <!-- GitHub Profile Link Button -->
        <div style="text-align: center; margin-top: 2rem;">
            <a href="https://github.com/teojuncheng" target="_blank" class="btn btn-github">
                <span style="font-size: 1.1rem;">💻</span> View GitHub Profile →
            </a>
        </div>
    </section>

</Layout>

<style>
    /* Header */
    .projects-hero {
        padding: 5rem 0 2rem;
        max-width: 820px;
    }

    .terminal-tag {
        font-family: 'JetBrains Mono', monospace;
        color: #38bdf8;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        letter-spacing: 0.05em;
    }

    .page-title {
        font-size: 3.25rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.15;
        margin-bottom: 1.25rem;
        letter-spacing: -0.03em;
    }

    .highlight {
        color: #38bdf8;
    }

    .hero-intro {
        color: #94a3b8;
        font-size: 1.15rem;
        line-height: 1.7;
    }

    .divider {
        height: 1px;
        background-color: #1e293b;
        margin: 2rem 0 3.5rem;
    }

    /* Content Sections */
    .content-section {
        margin-bottom: 4.5rem;
    }

    .section-heading {
        font-size: 2rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 2rem;
        letter-spacing: -0.02em;
    }

    /* Projects Grid */
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .project-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .project-card:hover {
        border-color: #38bdf8;
        transform: translateY(-2px);
    }

    .card-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.65rem;
        border-radius: 20px;
        text-decoration: none;
    }

    .badge-blue {
        background-color: rgba(56, 189, 248, 0.15);
        color: #38bdf8;
        border: 1px solid rgba(56, 189, 248, 0.3);
    }

    .badge-green {
        background-color: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }

    .badge-cyan {
        background-color: rgba(6, 182, 212, 0.15);
        color: #22d3ee;
        border: 1px solid rgba(6, 182, 212, 0.3);
    }

    .badge-purple {
        background-color: rgba(168, 85, 247, 0.15);
        color: #c084fc;
        border: 1px solid rgba(168, 85, 247, 0.3);
    }

    .badge-muted {
        background-color: #1e293b;
        color: #94a3b8;
    }

    .badge-link {
        background-color: #1e293b;
        color: #38bdf8;
        border: 1px solid #38bdf8;
        transition: background-color 0.2s ease;
    }

    .badge-link:hover {
        background-color: #38bdf8;
        color: #082f49;
    }

    .project-title {
        color: #ffffff;
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
        line-height: 1.35;
    }

    .project-desc {
        color: #94a3b8;
        font-size: 0.92rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    .tech-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: auto;
    }

    .tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        background-color: #1e293b;
        color: #cbd5e1;
        padding: 0.25rem 0.65rem;
        border-radius: 6px;
    }

    .tag-highlight {
        border: 1px solid rgba(56, 189, 248, 0.4);
        color: #38bdf8;
    }

    /* GitHub Activity */
    .github-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .github-stat-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 1.75rem 1.5rem;
        text-align: center;
    }

    .stat-number {
        font-size: 2.25rem;
        font-weight: 800;
        color: #38bdf8;
        margin-bottom: 0.35rem;
    }

    .stat-label {
        color: #94a3b8;
        font-size: 0.9rem;
    }

    /* Language Bar */
    .lang-bar-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 1.75rem 2rem;
    }

    .lang-header {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: #38bdf8;
        font-weight: 700;
        margin-bottom: 1rem;
        letter-spacing: 0.05em;
    }

    .lang-bar {
        display: flex;
        height: 10px;
        border-radius: 5px;
        overflow: hidden;
        margin-bottom: 1.25rem;
        background-color: #1e293b;
    }

    .bar-segment {
        height: 100%;
    }

    .bar-flutter { background-color: #02569b; }
    .bar-php { background-color: #777bb4; }
    .bar-astro { background-color: #ff5d01; }
    .bar-python { background-color: #3572a5; }
    .bar-js { background-color: #f1e05a; }

    .lang-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        font-size: 0.85rem;
        color: #94a3b8;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }

    .dot-flutter { background-color: #02569b; }
    .dot-php { background-color: #777bb4; }
    .dot-astro { background-color: #ff5d01; }
    .dot-python { background-color: #3572a5; }
    .dot-js { background-color: #f1e05a; }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.75rem;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-github {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        color: #f8fafc;
    }

    .btn-github:hover {
        border-color: #38bdf8;
        color: #38bdf8;
        transform: translateY(-2px);
    }
</style>
