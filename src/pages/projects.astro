---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects | Teo Jun Cheng">

    <!-- 1. EDITORIAL HEADER -->
    <header class="projects-hero">
        <div class="section-tag">01 // REPOSITORY</div>
        <h1 class="hero-title">Engineering <span class="gradient-text">Builds & Projects</span>.</h1>
        <p class="hero-intro">
            A production catalog of full-stack web platforms, decoupled mobile client applications, relational database schemas, and machine learning prototypes.
        </p>
    </header>

    <!-- 2. SELECTED ARCHITECTURAL BUILDS -->
    <section class="section-block">
        <div class="section-tag">02 // CASE STUDIES</div>
        <h2 class="section-heading">Featured Software Systems</h2>

        <div class="projects-stack">
            
            <!-- Project 1: ServeTogether -->
            <article class="project-card">
                <div class="card-header">
                    <div class="project-classification">
                        <span class="type-pill">ACADEMIC CAPSTONE (FYP)</span>
                        <span class="status-pill status-complete">✓ Completed</span>
                    </div>
                    <span class="access-badge">🔒 Private Source</span>
                </div>

                <div class="card-body">
                    <h3 class="project-name">ServeTogether — Personalised Volunteer System</h3>
                    <p class="project-desc">
                        A full-stack web platform designed to streamline community initiative coordination. Integrated an interest-based matchmaking algorithm to analyze participant preference profiles and deliver targeted event recommendations.
                    </p>

                    <div class="architecture-highlights">
                        <div class="arch-item">
                            <span class="arch-label">ARCHITECTURE</span>
                            <span class="arch-value">Monolithic MVC with Relational Persistence</span>
                        </div>
                        <div class="arch-item">
                            <span class="arch-label">CORE FUNCTION</span>
                            <span class="arch-value">Algorithmic User-Task Opportunity Matching</span>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <span class="tech-tag">PHP</span>
                    <span class="tech-tag">MySQL</span>
                    <span class="tech-tag">JavaScript (ES6)</span>
                    <span class="tech-tag">HTML5 / CSS3</span>
                    <span class="tech-tag">Git</span>
                </div>
            </article>

            <!-- Project 2: Quotation App -->
            <article class="project-card">
                <div class="card-header">
                    <div class="project-classification">
                        <span class="type-pill">ENTERPRISE CLIENT</span>
                        <span class="status-pill status-prod">⚡ In Production</span>
                    </div>
                    <span class="access-badge">🏢 Apploqic Technologies</span>
                </div>

                <div class="card-body">
                    <h3 class="project-name">Client Quotation & Estimator Engine</h3>
                    <p class="project-desc">
                        Decoupled cross-platform mobile client enabling prospective enterprise clients to select service variables, calculate cost models in real time, and dispatch formal quotation requests directly into remote Laravel API endpoints.
                    </p>

                    <div class="architecture-highlights">
                        <div class="arch-item">
                            <span class="arch-label">ARCHITECTURE</span>
                            <span class="arch-value">Decoupled Client-Server (REST API)</span>
                        </div>
                        <div class="arch-item">
                            <span class="arch-label">CLIENT TECH</span>
                            <span class="arch-value">Flutter / Dart Reactive State Management</span>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <span class="tech-tag tag-featured">Flutter</span>
                    <span class="tech-tag tag-featured">Laravel API</span>
                    <span class="tech-tag">Dart</span>
                    <span class="tech-tag">MySQL</span>
                    <span class="tech-tag">JSON REST</span>
                </div>
            </article>

            <!-- Project 3: Property App -->
            <article class="project-card">
                <div class="card-header">
                    <div class="project-classification">
                        <span class="type-pill">ENTERPRISE SYSTEM</span>
                        <span class="status-pill status-prod">⚡ In Production</span>
                    </div>
                    <span class="access-badge">🏢 Apploqic Technologies</span>
                </div>

                <div class="card-body">
                    <h3 class="project-name">Property Unit & Tenancy Management Application</h3>
                    <p class="project-desc">
                        End-to-end mobile management utility designed to organize property listings, track maintenance tickets, synchronize tenant logs, and maintain relational record integrity across live staging servers.
                    </p>

                    <div class="architecture-highlights">
                        <div class="arch-item">
                            <span class="arch-label">DEPLOYMENT</span>
                            <span class="arch-value">cPanel Host / Production MySQL Instances</span>
                        </div>
                        <div class="arch-item">
                            <span class="arch-label">INTEGRATION</span>
                            <span class="arch-value">Multi-tenant Authentication & API Sync</span>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <span class="tech-tag tag-featured">Flutter</span>
                    <span class="tech-tag tag-featured">Laravel API</span>
                    <span class="tech-tag">Dart</span>
                    <span class="tech-tag">cPanel</span>
                    <span class="tech-tag">MySQL</span>
                </div>
            </article>

            <!-- Project 4: AI Chatbot -->
            <article class="project-card">
                <div class="card-header">
                    <div class="project-classification">
                        <span class="type-pill">HACKATHON BUILD</span>
                        <span class="status-pill status-prototype">🤖 Prototype</span>
                    </div>
                    <a href="https://github.com/teojuncheng" target="_blank" rel="noopener noreferrer" class="repo-link">
                        <span>Source Code</span>
                        <span>↗</span>
                    </a>
                </div>

                <div class="card-body">
                    <h3 class="project-name">AI Sales Recommendation Chatbot</h3>
                    <p class="project-desc">
                        Machine learning prototype built during the UM Hackathon. Evaluated customer interaction patterns across transactional datasets to formulate dynamic product upsell suggestions and contextual recommendations.
                    </p>

                    <div class="architecture-highlights">
                        <div class="arch-item">
                            <span class="arch-label">PIPELINE</span>
                            <span class="arch-value">Feature Engineering & Dataset Vectorization</span>
                        </div>
                        <div class="arch-item">
                            <span class="arch-label">TARGET DOMAIN</span>
                            <span class="arch-value">Conversational Retail Recommendation Engine</span>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <span class="tech-tag">Python</span>
                    <span class="tech-tag">Pandas</span>
                    <span class="tech-tag">Data Analytics</span>
                    <span class="tech-tag">Machine Learning</span>
                </div>
            </article>

        </div>
    </section>

    <!-- 3. CODE REPOSITORIES & GIT METRICS -->
    <section class="section-block" style="margin-bottom: 6rem;">
        <div class="section-tag">03 // TELEMETRY</div>
        <h2 class="section-heading">Open Source & Version Control</h2>

        <div class="telemetry-panel">
            <div class="telemetry-grid">
                <div class="telemetry-tile">
                    <span class="tile-val">10+</span>
                    <span class="tile-label">Repositories</span>
                </div>
                <div class="telemetry-tile">
                    <span class="tile-val">200+</span>
                    <span class="tile-label">Commits Tracked</span>
                </div>
                <div class="telemetry-tile">
                    <span class="tile-val">300+</span>
                    <span class="tile-label">Contributions</span>
                </div>
                <div class="telemetry-tile">
                    <span class="tile-val text-emerald">2022</span>
                    <span class="tile-label">Git Member Since</span>
                </div>
            </div>

            <div class="breakdown-wrapper">
                <div class="breakdown-title">SYSTEM LANGUAGE DENSITY</div>
                <div class="ratio-bar">
                    <div class="seg seg-flutter" style="width: 35%;"></div>
                    <div class="seg seg-php" style="width: 25%;"></div>
                    <div class="seg seg-astro" style="width: 20%;"></div>
                    <div class="seg seg-python" style="width: 12%;"></div>
                    <div class="seg seg-js" style="width: 8%;"></div>
                </div>
                <div class="ratio-legend">
                    <span class="legend-unit"><span class="legend-dot seg-flutter"></span> Flutter / Dart (35%)</span>
                    <span class="legend-unit"><span class="legend-dot seg-php"></span> PHP / Laravel (25%)</span>
                    <span class="legend-unit"><span class="legend-dot seg-astro"></span> Astro (20%)</span>
                    <span class="legend-unit"><span class="legend-dot seg-python"></span> Python (12%)</span>
                    <span class="legend-unit"><span class="legend-dot seg-js"></span> JavaScript (8%)</span>
                </div>
            </div>

            <div class="telemetry-cta">
                <a href="https://github.com/teojuncheng" target="_blank" rel="noopener noreferrer" class="btn btn-emerald">
                    Inspect GitHub Repositories ↗
                </a>
            </div>
        </div>
    </section>

</Layout>

<style>
    /* Hero */
    .projects-hero {
        padding: 5rem 0 2.5rem;
        max-width: 860px;
    }

    .section-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #10b981;
        letter-spacing: 0.1em;
        margin-bottom: 0.75rem;
    }

    .hero-title {
        font-size: 2.85rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.2;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }

    .gradient-text {
        background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-intro {
        color: #94a3b8;
        font-size: 1.15rem;
        line-height: 1.7;
    }

    /* Section Structure */
    .section-block {
        margin-top: 3.5rem;
        margin-bottom: 5.5rem;
    }

    .section-heading {
        font-size: 1.85rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.02em;
        margin-bottom: 2rem;
    }

    /* Projects Stack */
    .projects-stack {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .project-card {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2.25rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        transition: border-color 0.2s ease;
    }

    .project-card:hover {
        border-color: #10b981;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        border-bottom: 1px solid #162032;
        padding-bottom: 1rem;
    }

    .project-classification {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .type-pill {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: #94a3b8;
        background-color: #162032;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        letter-spacing: 0.05em;
    }

    .status-pill {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        font-weight: 600;
    }

    .status-complete {
        background-color: rgba(56, 189, 248, 0.1);
        color: #38bdf8;
        border: 1px solid rgba(56, 189, 248, 0.25);
    }

    .status-prod {
        background-color: rgba(16, 185, 129, 0.1);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .status-prototype {
        background-color: rgba(168, 85, 247, 0.1);
        color: #c084fc;
        border: 1px solid rgba(168, 85, 247, 0.25);
    }

    .access-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #64748b;
    }

    .repo-link {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        color: #34d399;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.25rem 0.6rem;
        background-color: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 4px;
        transition: all 0.2s ease;
    }

    .repo-link:hover {
        background-color: #10b981;
        color: #022c22;
    }

    .project-name {
        color: #ffffff;
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
        line-height: 1.3;
    }

    .project-desc {
        color: #94a3b8;
        font-size: 0.95rem;
        line-height: 1.7;
        margin-bottom: 1.5rem;
    }

    /* Architecture Highlights */
    .architecture-highlights {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1rem;
        background-color: #090d16;
        border: 1px solid #162032;
        border-radius: 6px;
        padding: 1.25rem;
        margin-bottom: 0.5rem;
    }

    .arch-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .arch-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: #10b981;
        letter-spacing: 0.06em;
    }

    .arch-value {
        color: #e2e8f0;
        font-size: 0.88rem;
        font-weight: 500;
    }

    /* Card Footer & Tags */
    .card-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        border-top: 1px solid #162032;
        padding-top: 1.25rem;
    }

    .tech-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        background-color: #162032;
        color: #cbd5e1;
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        border: 1px solid #223249;
    }

    .tag-featured {
        border-color: rgba(16, 185, 129, 0.35);
        color: #34d399;
    }

    /* Telemetry Panel */
    .telemetry-panel {
        background-color: #0c1222;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2.25rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .telemetry-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1.25rem;
    }

    .telemetry-tile {
        background-color: #090d16;
        border: 1px solid #162032;
        border-radius: 6px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .tile-val {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.85rem;
        font-weight: 800;
        color: #f8fafc;
    }

    .tile-label {
        font-size: 0.8rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .text-emerald {
        color: #34d399 !important;
    }

    /* Breakdown Bar */
    .breakdown-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #10b981;
        letter-spacing: 0.08em;
        margin-bottom: 0.75rem;
    }

    .ratio-bar {
        display: flex;
        height: 8px;
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 1.25rem;
        background-color: #162032;
    }

    .seg { height: 100%; }
    .seg-flutter { background-color: #0284c7; }
    .seg-php { background-color: #8b5cf6; }
    .seg-astro { background-color: #f97316; }
    .seg-python { background-color: #10b981; }
    .seg-js { background-color: #eab308; }

    .ratio-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        font-size: 0.82rem;
        color: #94a3b8;
    }

    .legend-unit {
        display: flex;
        align-items: center;
        gap: 0.45rem;
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .telemetry-cta {
        display: flex;
        justify-content: flex-start;
        border-top: 1px solid #162032;
        padding-top: 1.5rem;
    }

    /* Button */
    .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.6rem;
        border-radius: 6px;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-emerald {
        background-color: #10b981;
        color: #022c22;
    }

    .btn-emerald:hover {
        background-color: #34d399;
        transform: translateY(-2px);
        box-shadow: 0 4px 18px rgba(16, 185, 129, 0.3);
    }
</style>
