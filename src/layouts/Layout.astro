---
interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

// 1. Import the global CSS file directly into the layout
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <!-- Google Fonts for crisp modern typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Top Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <a href="/" class="brand">&lt;TeoJunCheng /&gt;</a>
            <ul class="nav-links">
                <li><a href="/" class={currentPath === "/" ? "active" : ""}>Home</a></li>
                <li><a href="/about" class={currentPath.startsWith("/about") ? "active" : ""}>About</a></li>
                <li><a href="/projects" class={currentPath.startsWith("/projects") ? "active" : ""}>Projects</a></li>
                <li><a href="/career" class={currentPath.startsWith("/career") ? "active" : ""}>Career</a></li>
                <li><a href="/contact" class={currentPath.startsWith("/contact") ? "active" : ""}>Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- Main Body Container -->
    <main class="container">
        <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>© 2026 Teo Jun Cheng • Built with Astro & Hosted on GitHub Pages</p>
        </div>
    </footer>

</body>
</html>
